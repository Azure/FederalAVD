{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.48.1.52935",
      "templateHash": "10749179182174799801"
    },
    "name": "Monitoring association remediation template",
    "description": "Creates a data collection rule or endpoint association on an existing VM in the deployment resource group according to the supplied association type."
  },
  "parameters": {
    "associationType": {
      "type": "string",
      "metadata": {
        "description": "Required. Association selector: DataCollectionRule or DataCollectionEndpoint."
      }
    },
    "monitoringResourceId": {
      "type": "string",
      "metadata": {
        "description": "Required. Resource ID of the existing data collection rule or endpoint selected by associationType."
      }
    },
    "virtualMachineName": {
      "type": "string",
      "metadata": {
        "description": "Required. Name of the existing VM in the deployment resource group."
      }
    }
  },
  "variables": {
    "dcrAssociationName": "[format('assoc-{0}', uniqueString(parameters('virtualMachineName'), parameters('monitoringResourceId')))]",
    "dceAssociationName": "configurationAccessEndpoint"
  },
  "resources": [
    {
      "condition": "[equals(parameters('associationType'), 'DataCollectionRule')]",
      "type": "Microsoft.Insights/dataCollectionRuleAssociations",
      "apiVersion": "2023-03-11",
      "scope": "[resourceId('Microsoft.Compute/virtualMachines', parameters('virtualMachineName'))]",
      "name": "[variables('dcrAssociationName')]",
      "properties": {
        "dataCollectionRuleId": "[parameters('monitoringResourceId')]"
      }
    },
    {
      "condition": "[equals(parameters('associationType'), 'DataCollectionEndpoint')]",
      "type": "Microsoft.Insights/dataCollectionRuleAssociations",
      "apiVersion": "2023-03-11",
      "scope": "[resourceId('Microsoft.Compute/virtualMachines', parameters('virtualMachineName'))]",
      "name": "[variables('dceAssociationName')]",
      "properties": {
        "dataCollectionEndpointId": "[parameters('monitoringResourceId')]"
      }
    }
  ]
}