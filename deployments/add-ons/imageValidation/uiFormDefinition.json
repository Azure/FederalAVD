{
  "$schema": "https://schema.management.azure.com/schemas/2021-09-09/uiFormDefinition.schema.json",
  "view": {
    "kind": "Form",
    "properties": {
      "title": "Image Validation Add-On",
      "steps": [
        {
          "name": "basics",
          "label": "Basics",
          "elements": [
            {
              "name": "scope",
              "type": "Microsoft.Common.Section",
              "label": "Deployment Scope",
              "elements": [
                {
                  "name": "overview",
                  "type": "Microsoft.Common.TextBlock",
                  "options": {
                    "text": "Deploy a Windows PowerShell timer Function App and supporting infrastructure for Image Validation. Select the deployment subscription, region, and existing Compute Gallery image definition. Resource group and resource names are configured on Naming + Tags. Verify the validation implementation and its workload permissions before enabling scheduled execution."
                  }
                },
                {
                  "name": "subscription",
                  "type": "Microsoft.Common.SubscriptionSelector",
                  "resourceProviders": [
                    "Microsoft.Authorization",
                    "Microsoft.Compute",
                    "Microsoft.Insights",
                    "Microsoft.KeyVault",
                    "Microsoft.ManagedIdentity",
                    "Microsoft.Network",
                    "Microsoft.Resources",
                    "Microsoft.Storage",
                    "Microsoft.Web"
                  ],
                  "constraints": {
                    "validations": [
                      {
                        "isValid": "[not(empty(steps('basics').scope.subscription.subscriptionId))]",
                        "message": "Select a deployment subscription."
                      }
                    ]
                  }
                },
                {
                  "name": "locationsApi",
                  "type": "Microsoft.Solutions.ArmApiControl",
                  "request": {
                    "method": "GET",
                    "path": "[concat('/subscriptions/', steps('basics').scope.subscription.subscriptionId, '/locations?api-version=2020-01-01')]"
                  }
                },
                {
                  "name": "location",
                  "type": "Microsoft.Common.LocationSelector",
                  "label": "Region",
                  "toolTip": "Region for the resource group and function app infrastructure. Verify Windows Dedicated plan and PowerShell runtime availability in this cloud and region.",
                  "resourceTypes": [
                    "Microsoft.Authorization/roleAssignments",
                    "Microsoft.Compute/diskEncryptionSets",
                    "Microsoft.Compute/virtualMachines",
                    "Microsoft.Insights/components",
                    "Microsoft.Insights/diagnosticSettings",
                    "Microsoft.Insights/privateLinkScopes",
                    "Microsoft.KeyVault/vaults",
                    "Microsoft.ManagedIdentity/userAssignedIdentities",
                    "Microsoft.Network/networkInterfaces",
                    "Microsoft.Network/privateEndpoints",
                    "Microsoft.Resources/resourceGroups",
                    "Microsoft.Resources/templateSpecs",
                    "Microsoft.Storage/storageAccounts",
                    "Microsoft.Web/serverFarms",
                    "Microsoft.Web/sites"
                  ],
                  "allowedValues": "[map(filter(steps('basics').scope.locationsApi.value, (item) => equals(item.metadata.regionType, 'Physical')), (item) => item.name)]",
                  "scope": {
                    "subscriptionId": "[steps('basics').scope.subscription.subscriptionId]"
                  },
                  "visible": true
                }
              ]
            }
          ]
        },
        {
          "name": "validationVm",
          "label": "Validation VM Settings",
          "elements": [
            {
              "name": "vmInfo",
              "type": "Microsoft.Common.TextBlock",
              "options": {
                "text": "Configure the inputs passed to the validation VM Template Spec. The VM, OS disk, and NIC names are generated by the shared naming framework. Select an existing image version under the Basics image definition, a credentials Key Vault, and a VM subnet in the selected region. Verify VM size/image compatibility, accelerated networking support, static IP availability, and workload permissions. Run Commands are configured through runCommandSettings in a parameter file."
              }
            },
            {
              "name": "imageSettings",
              "type": "Microsoft.Common.Section",
              "label": "Image Settings",
              "elements": [
                {
                  "name": "gallery",
                  "type": "Microsoft.Solutions.ResourceSelector",
                  "label": "Compute gallery",
                  "toolTip": "Select the compute gallery containing the image for the validation VM.",
                  "resourceType": "Microsoft.Compute/galleries",
                  "scope": {
                    "location": "[steps('basics').scope.location.name]",
                    "subscriptionId": "[steps('basics').scope.subscription.subscriptionId]"
                  },
                  "visible": true,
                  "constraints": {
                    "required": true
                  }
                },
                {
                  "name": "imagesApi",
                  "type": "Microsoft.Solutions.ArmApiControl",
                  "request": {
                    "method": "GET",
                    "path": "[concat(steps('validationVm').imageSettings.gallery.id, '/images?api-version=2022-03-03')]"
                  }
                },
                {
                  "name": "image",
                  "type": "Microsoft.Common.DropDown",
                  "visible": true,
                  "filter": false,
                  "label": "Image",
                  "defaultValue": "",
                  "toolTip": "Select the compute gallery image for the validation VM.",
                  "constraints": {
                    "allowedValues": "[map(steps('validationVm').imageSettings.imagesApi.value, (item) => parse(concat('{\"label\":\"', item.name, '\",\"value\":\"', item.id, '\"}')))]",
                    "required": true
                  }
                },
                {
                  "name": "versionsApi",
                  "type": "Microsoft.Solutions.ArmApiControl",
                  "request": {
                    "method": "GET",
                    "path": "[concat(steps('validationVm').imageSettings.image, '/versions?api-version=2022-03-03')]",
                    "transforms": {
                      "list": "reverse(sort_by(value, &properties.publishingProfile.publishedDate)[].{label:name, value:id})"
                    }
                  }
                },
                {
                  "name": "licenseType",
                  "type": "Microsoft.Common.DropDown",
                  "label": "Image License Type",
                  "defaultValue": "Windows Client",
                  "constraints": {
                    "required": true,
                    "allowedValues": [
                      {
                        "label": "Windows Client",
                        "value": "Windows_Client"
                      },
                      {
                        "label": "Windows Server",
                        "value": "Windows_Server"
                      }
                    ]
                  }
                }
              ]
            },
            {
              "name": "credentials",
              "type": "Microsoft.Common.Section",
              "label": "Credentials",
              "elements": [
                {
                  "name": "keyVault",
                  "type": "Microsoft.Solutions.ResourceSelector",
                  "label": "Key Vault for Secrets",
                  "toolTip": "Select the existing key vault containing LocalAdminUsername and LocalAdminPassword secrets. Enable template deployment on the vault and authorize the deployment principal. Do not enter credentials in the form.",
                  "resourceType": "Microsoft.KeyVault/vaults",
                  "constraints": {
                    "required": true
                  }
                }
              ]
            },
            {
              "name": "network",
              "type": "Microsoft.Common.Section",
              "label": "Network Settings",
              "elements": [
                {
                  "name": "virtualNetwork",
                  "type": "Microsoft.Solutions.ResourceSelector",
                  "label": "Virtual network",
                  "resourceType": "Microsoft.Network/virtualNetworks",
                  "scope": {
                    "location": "[steps('basics').scope.location.name]",
                    "subscriptionId": "[steps('basics').scope.subscription.subscriptionId]"
                  },
                  "visible": true,
                  "constraints": {
                    "required": true
                  }
                },
                {
                  "name": "subnetsApi",
                  "type": "Microsoft.Solutions.ArmApiControl",
                  "condition": "[not(empty(steps('validationVm').network.virtualNetwork))]",
                  "request": {
                    "method": "GET",
                    "path": "[concat(steps('validationVm').network.virtualNetwork.id, '/subnets?api-version=2022-05-01')]"
                  }
                },
                {
                  "name": "subnet",
                  "type": "Microsoft.Common.DropDown",
                  "visible": true,
                  "filter": false,
                  "label": "Subnet",
                  "defaultValue": "",
                  "toolTip": "Select the subnet for the validation VM.",
                  "constraints": {
                    "allowedValues": "[map(filter(steps('validationVm').network.subnetsApi.value, (item) => and(empty(item.properties.delegations), not(contains(item.name, 'Bastion')), not(contains(item.name, 'Firewall')))), (item) => parse(concat('{\"label\":\"', item.name, '\",\"value\":\"', item.id, '\"}')))]",
                    "required": true
                  }
                },
                {
                  "name": "privateIPAddress",
                  "type": "Microsoft.Common.TextBox",
                  "label": "Validation VM Static Private IPv4 Address",
                  "toolTip": "Enter an available IPv4 address in the selected VM subnet. Address availability and subnet membership must be checked before deployment.",
                  "constraints": {
                    "required": true,
                    "validations": [
                      {
                        "regex": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$",
                        "message": "Enter an IPv4 address with four octets between 0 and 255."
                      }
                    ]
                  }
                }
              ]
            },
            {
              "name": "size",
              "type": "Microsoft.Compute.SizeSelector",
              "label": "Size",
              "toolTip": "Select the size of the virtual machine.",
              "recommendedSizes": [
                "Standard_D4ads_v5"
              ],
              "osPlatform": "Windows",
              "count": 1,
              "visible": true,
              "scope": {
                "location": "[steps('basics').scope.location.name]",
                "subscriptionId": "[steps('basics').scope.subscription.subscriptionId]"
              }
            }
          ]
        },
        {
          "name": "functionApp",
          "label": "Function App Settings",
          "elements": [
            {
              "name": "hostingInfo",
              "type": "Microsoft.Common.TextBlock",
              "options": {
                "text": "The deployment creates a Windows Dedicated PremiumV3_P0v3 plan unless you select an existing plan. An existing plan must be Windows Dedicated, in the selected region, and support VNet integration and Always On. Runtime storage uses an HSM-backed customer-managed key in a new Premium encryption Key Vault, separate from the VM credentials vault. The key name matches the resolved storage account name. The timer code is packaged from the repository scripts; this form does not upload or replace validation code."
              }
            },
            {
              "name": "hostingPlan",
              "type": "Microsoft.Common.DropDown",
              "label": "App Service Plan",
              "defaultValue": "Create new",
              "constraints": {
                "required": true,
                "allowedValues": [
                  {
                    "label": "Create new",
                    "value": "new"
                  },
                  {
                    "label": "Use existing",
                    "value": "existing"
                  }
                ]
              }
            },
            {
              "name": "existingPlan",
              "type": "Microsoft.Solutions.ResourceSelector",
              "label": "Existing Windows Dedicated Plan",
              "resourceType": "Microsoft.Web/serverFarms",
              "scope": {
                "subscriptionId": "[steps('basics').scope.subscription.subscriptionId]",
                "location": "[steps('basics').scope.location.name]"
              },
              "visible": "[equals(steps('functionApp').hostingPlan, 'existing')]",
              "constraints": {
                "required": "[equals(steps('functionApp').hostingPlan, 'existing')]"
              }
            },
            {
              "name": "schedule",
              "type": "Microsoft.Common.TextBox",
              "label": "Cron schedule",
              "toolTip": "Enter six NCRONTAB fields: second minute hour day month day-of-week, or an app-setting reference such as %ImageValidationSchedule%. Timer time zone is UTC unless configured through supported Function App settings. Verify ranges and supported syntax before deployment.",
              "placeholder": "0 0 2 * * *",
              "constraints": {
                "required": true,
                "validations": [
                  {
                    "regex": "^(?:\\S+\\s+){5}\\S+$|^%[^%\\s]+%$",
                    "message": "Enter six whitespace-separated NCRONTAB fields or an app-setting reference enclosed in percent signs."
                  }
                ]
              }
            },
            {
              "name": "networkSettings",
              "type": "Microsoft.Common.Section",
              "label": "Network Settings",
              "elements": [
                {
                  "name": "privateEndpoint",
                  "type": "Microsoft.Common.DropDown",
                  "label": "Network Access",
                  "defaultValue": "Private endpoints (recommended)",
                  "constraints": {
                    "required": true,
                    "allowedValues": [
                      {
                        "label": "Private endpoints (recommended)",
                        "value": "private"
                      },
                      {
                        "label": "Public app and storage access",
                        "value": "public"
                      }
                    ]
                  }
                },
                {
                  "name": "publicWarning",
                  "type": "Microsoft.Common.TextBlock",
                  "visible": "[equals(steps('functionApp').networkSettings.privateEndpoint, 'public')]",
                  "options": {
                    "text": "Public mode explicitly enables public Function App, runtime storage, and encryption Key Vault access and does not configure private endpoints or VNet integration through this form. CMK remains enabled. Use only when approved by your network and security owners."
                  }
                },
                {
                  "name": "prerequisites",
                  "type": "Microsoft.Common.TextBlock",
                  "visible": "[equals(steps('functionApp').networkSettings.privateEndpoint, 'private')]",
                  "options": {
                    "text": "VNets, subnets, and private DNS zones are not created by this add-on. Supply a same-region integration subnet delegated to Microsoft.Web/serverFarms and a separate subnet for app, blob, and encryption-vault private endpoints. Existing blob, Function App, and Key Vault private DNS zones must match the target cloud and be linked to the integration VNet. Verify app/SCM records, vault DNS resolution, routing, firewall access, and available subnet addresses. The vault retains AzureServices bypass for trusted encryption integrations."
                  }
                },
                {
                  "name": "integrationSubnetId",
                  "type": "Microsoft.Common.TextBox",
                  "label": "Function App Integration Subnet Resource ID",
                  "visible": "[equals(steps('functionApp').networkSettings.privateEndpoint, 'private')]",
                  "constraints": {
                    "required": "[equals(steps('functionApp').networkSettings.privateEndpoint, 'private')]",
                    "validations": [
                      {
                        "regex": "^/subscriptions/[^/\\s]+/resourceGroups/[^/\\s]+/providers/Microsoft\\.Network/virtualNetworks/[^/\\s]+/subnets/[^/\\s]+$",
                        "message": "Enter a complete virtual network subnet resource ID."
                      }
                    ]
                  }
                },
                {
                  "name": "endpointSubnetId",
                  "type": "Microsoft.Common.TextBox",
                  "label": "Private Endpoint Subnet Resource ID",
                  "visible": "[equals(steps('functionApp').networkSettings.privateEndpoint, 'private')]",
                  "constraints": {
                    "required": "[equals(steps('functionApp').networkSettings.privateEndpoint, 'private')]",
                    "validations": [
                      {
                        "regex": "^/subscriptions/[^/\\s]+/resourceGroups/[^/\\s]+/providers/Microsoft\\.Network/virtualNetworks/[^/\\s]+/subnets/[^/\\s]+$",
                        "message": "Enter a complete virtual network subnet resource ID."
                      },
                      {
                        "isValid": "[not(equals(toLower(steps('functionApp').networkSettings.integrationSubnetId), toLower(steps('functionApp').networkSettings.endpointSubnetId)))]",
                        "message": "Use separate integration and private-endpoint subnets."
                      }
                    ]
                  }
                },
                {
                  "name": "blobDnsZone",
                  "type": "Microsoft.Solutions.ResourceSelector",
                  "label": "Blob Private DNS Zone",
                  "toolTip": "Select the target cloud's blob private DNS zone, linked to the integration VNet.",
                  "resourceType": "Microsoft.Network/privateDnsZones",
                  "visible": "[equals(steps('functionApp').networkSettings.privateEndpoint, 'private')]",
                  "constraints": {
                    "required": "[equals(steps('functionApp').networkSettings.privateEndpoint, 'private')]"
                  }
                },
                {
                  "name": "appDnsZone",
                  "type": "Microsoft.Solutions.ResourceSelector",
                  "label": "Function App Private DNS Zone",
                  "toolTip": "Select the target cloud's App Service private DNS zone, linked to the integration VNet.",
                  "resourceType": "Microsoft.Network/privateDnsZones",
                  "visible": "[equals(steps('functionApp').networkSettings.privateEndpoint, 'private')]",
                  "constraints": {
                    "required": "[equals(steps('functionApp').networkSettings.privateEndpoint, 'private')]"
                  }
                },
                {
                  "name": "vaultDnsZone",
                  "type": "Microsoft.Solutions.ResourceSelector",
                  "label": "Encryption Key Vault Private DNS Zone",
                  "toolTip": "Select the target cloud's Key Vault private DNS zone, linked to the integration VNet.",
                  "resourceType": "Microsoft.Network/privateDnsZones",
                  "visible": "[equals(steps('functionApp').networkSettings.privateEndpoint, 'private')]",
                  "constraints": {
                    "required": "[equals(steps('functionApp').networkSettings.privateEndpoint, 'private')]"
                  }
                }
              ]
            },
            {
              "name": "monitoring",
              "type": "Microsoft.Common.Section",
              "label": "Monitoring",
              "elements": [
                {
                  "name": "enableMonitoring",
                  "type": "Microsoft.Common.DropDown",
                  "label": "Application Insights and Function Logs",
                  "defaultValue": "Disabled",
                  "constraints": {
                    "required": true,
                    "allowedValues": [
                      {
                        "label": "Disabled",
                        "value": "disabled"
                      },
                      {
                        "label": "Use an existing Log Analytics workspace",
                        "value": "enabled"
                      }
                    ]
                  }
                },
                {
                  "name": "workspace",
                  "type": "Microsoft.Solutions.ResourceSelector",
                  "label": "Log Analytics Workspace",
                  "resourceType": "Microsoft.OperationalInsights/workspaces",
                  "visible": "[equals(steps('functionApp').monitoring.enableMonitoring, 'enabled')]",
                  "constraints": {
                    "required": "[equals(steps('functionApp').monitoring.enableMonitoring, 'enabled')]"
                  }
                },
                {
                  "name": "privateMonitoring",
                  "type": "Microsoft.Common.DropDown",
                  "label": "Monitoring Connectivity",
                  "defaultValue": "Public ingestion and query endpoints",
                  "visible": "[equals(steps('functionApp').monitoring.enableMonitoring, 'enabled')]",
                  "constraints": {
                    "required": "[equals(steps('functionApp').monitoring.enableMonitoring, 'enabled')]",
                    "allowedValues": [
                      {
                        "label": "Public ingestion and query endpoints",
                        "value": "public"
                      },
                      {
                        "label": "Use an existing Azure Monitor Private Link Scope",
                        "value": "private"
                      }
                    ]
                  }
                },
                {
                  "name": "monitoringInfo",
                  "type": "Microsoft.Common.TextBlock",
                  "visible": "[equals(steps('functionApp').monitoring.enableMonitoring, 'enabled')]",
                  "options": {
                    "text": "Private app/storage access does not automatically make monitoring private. Without an Azure Monitor Private Link Scope, Insights uses public ingestion and query endpoints. For private monitoring, select an existing configured scope and verify its workspace association, endpoints, DNS, and routing."
                  }
                },
                {
                  "name": "privateLinkScope",
                  "type": "Microsoft.Solutions.ResourceSelector",
                  "label": "Azure Monitor Private Link Scope",
                  "resourceType": "Microsoft.Insights/privateLinkScopes",
                  "visible": "[and(equals(steps('functionApp').monitoring.enableMonitoring, 'enabled'), equals(steps('functionApp').monitoring.privateMonitoring, 'private'))]",
                  "constraints": {
                    "required": "[and(equals(steps('functionApp').monitoring.enableMonitoring, 'enabled'), equals(steps('functionApp').monitoring.privateMonitoring, 'private'))]"
                  }
                }
              ]
            }
          ]
        },
        {
          "name": "namingAndTags",
          "label": "Naming + Tags",
          "elements": [
            {
              "name": "naming",
              "type": "Microsoft.Common.Section",
              "label": "Naming",
              "elements": [
                {
                  "name": "namingInfo",
                  "type": "Microsoft.Common.TextBlock",
                  "options": {
                    "text": "Names use the centralized FederalAVD naming defaults and the identifier below. Leave overrides empty to generate names. Explicit overrides bypass generation; ensure globally unique app and storage names are available. The deployment manages the named resource group. Changing naming inputs can create new resources, not migrate an existing instance. For custom namingConvention objects, use a parameter file."
                  }
                },
                {
                  "name": "identifier",
                  "type": "Microsoft.Common.TextBox",
                  "label": "Add-on Identifier",
                  "defaultValue": "iv",
                  "toolTip": "Use a short, distinct identifier for each independent instance. Generated storage names must fit the 24-character service limit.",
                  "constraints": {
                    "required": true,
                    "validations": [
                      {
                        "regex": "^[a-zA-Z0-9][a-zA-Z0-9-]*$",
                        "message": "Start with a letter or digit and use only letters, digits, and hyphens."
                      }
                    ]
                  }
                },
                {
                  "name": "resourceGroup",
                  "type": "Microsoft.Common.TextBox",
                  "label": "Resource Group Name",
                  "defaultValue": "",
                  "constraints": {
                    "required": false,
                    "validations": [
                      {
                        "regex": "^[a-zA-Z0-9_()\\-.]{1,90}$",
                        "message": "Use 1-90 letters, digits, underscores, parentheses, hyphens, or periods."
                      },
                      {
                        "isValid": "[not(endsWith(steps('namingAndTags').naming.resourceGroup, '.'))]",
                        "message": "Resource group names cannot end with a period."
                      }
                    ]
                  }
                },
                {
                  "name": "identity",
                  "type": "Microsoft.Common.TextBox",
                  "label": "User-Assigned Managed Identity Name",
                  "defaultValue": "",
                  "constraints": {
                    "required": false,
                    "validations": [
                      {
                        "regex": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$",
                        "message": "Use 3-128 letters, digits, hyphens, or underscores; start with a letter or digit."
                      }
                    ]
                  }
                },
                {
                  "name": "encryptionKeyVault",
                  "type": "Microsoft.Common.TextBox",
                  "label": "Storage Encryption Key Vault Name",
                  "defaultValue": "",
                  "toolTip": "Leave empty to use the shared naming framework. This new Premium vault stores the runtime storage CMK, not VM credentials.",
                  "constraints": {
                    "required": false,
                    "validations": [
                      {
                        "regex": "^[a-zA-Z][a-zA-Z0-9-]{1,22}[a-zA-Z0-9]$",
                        "message": "Use 3-24 letters, digits, or hyphens; start with a letter and end with a letter or digit."
                      },
                      {
                        "isValid": "[not(contains(steps('namingAndTags').naming.encryptionKeyVault, '--'))]",
                        "message": "Key Vault names cannot contain consecutive hyphens."
                      }
                    ]
                  }
                },
                {
                  "name": "plan",
                  "type": "Microsoft.Common.TextBox",
                  "label": "New App Service Plan Name",
                  "defaultValue": "",
                  "visible": "[equals(steps('functionApp').hostingPlan, 'new')]",
                  "constraints": {
                    "required": false,
                    "validations": [
                      {
                        "regex": "^[a-zA-Z0-9-]{1,60}$",
                        "message": "Use 1-60 letters, digits, or hyphens."
                      }
                    ]
                  }
                },
                {
                  "name": "functionApp",
                  "type": "Microsoft.Common.TextBox",
                  "label": "Function App Name",
                  "defaultValue": "",
                  "constraints": {
                    "required": false,
                    "validations": [
                      {
                        "regex": "^[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,58}[a-zA-Z0-9])?$",
                        "message": "Use 2-60 letters, digits, or hyphens; start and end with a letter or digit."
                      },
                      {
                        "isValid": "[or(empty(steps('namingAndTags').naming.functionApp), greaterOrEquals(length(steps('namingAndTags').naming.functionApp), 2))]",
                        "message": "Function App names must contain at least two characters."
                      }
                    ]
                  }
                },
                {
                  "name": "storage",
                  "type": "Microsoft.Common.TextBox",
                  "label": "Runtime Storage Account Name",
                  "defaultValue": "",
                  "constraints": {
                    "required": false,
                    "validations": [
                      {
                        "regex": "^[a-z0-9]{3,24}$",
                        "message": "Use 3-24 lowercase letters or digits."
                      }
                    ]
                  }
                }
              ]
            },
            {
              "name": "tagsSection",
              "type": "Microsoft.Common.Section",
              "label": "Tags",
              "elements": [
                {
                  "name": "tagsInfo",
                  "type": "Microsoft.Common.TextBlock",
                  "options": {
                    "text": "Enter tags to apply to all the resources that support tags in this solution."
                  }
                },
                {
                  "name": "tags",
                  "type": "Microsoft.Common.EditableGrid",
                  "label": "Tags",
                  "ariaLabel": "Enter tag key and value pairs",
                  "constraints": {
                    "width": "Full",
                    "rows": {
                      "count": {
                        "min": 0,
                        "max": 50
                      }
                    },
                    "columns": [
                      {
                        "id": "key",
                        "header": "Key",
                        "width": "1fr",
                        "element": {
                          "type": "Microsoft.Common.TextBox",
                          "placeholder": "Environment",
                          "constraints": {
                            "required": true,
                            "validations": [
                              {
                                "regex": "^[^<>%&\\\\?/\\x00-\\x1F]{1,128}$",
                                "message": "Use 1-128 characters without <, >, %, &, backslash, question mark, slash, or control characters."
                              },
                              {
                                "isValid": "[equals(length(filter(steps('namingAndTags').tagsSection.tags, (item) => equals(toLower(item.key), toLower(last(take(steps('namingAndTags').tagsSection.tags, $rowIndex)).key)))), 1)]",
                                "message": "Tag keys must be unique, ignoring case."
                              }
                            ]
                          }
                        }
                      },
                      {
                        "id": "value",
                        "header": "Value",
                        "width": "1fr",
                        "element": {
                          "type": "Microsoft.Common.TextBox",
                          "placeholder": "Production",
                          "constraints": {
                            "required": false,
                            "validations": [
                              {
                                "regex": "^[\\s\\S]{0,256}$",
                                "message": "Tag values cannot exceed 256 characters."
                              }
                            ]
                          }
                        }
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "outputs": {
      "kind": "Subscription",
      "subscriptionId": "[steps('basics').scope.subscription.subscriptionId]",
      "location": "[steps('basics').scope.location.name]",
      "parameters": {
