      "type": "string",
      "metadata": {
        "description": "Lowercase storage account name without the convention delimiter, limited to 24 characters."
      },
      "value": "[__bicep.resourceName(parameters('namingConvention'), 'replacerStorage', variables('loc'), parameters('identifier'), parameters('uniqueString'))]"
    },
    "storageEncryptionIdentityName": {
      "type": "string",
      "metadata": {
