{
	"$schema": "https://schema.management.azure.com/schemas/2021-09-09/uiFormDefinition.schema.json",
	"view": {
		"kind": "Form",
		"properties": {
			"title": "Run Scripts on Virtual Machines",
			"steps": [
				{
					"name": "basics",
					"label": "Virtual Machines",
					"elements": [
						{
							"name": "introBox",
							"type": "Microsoft.Common.TextBlock",
							"visible": true,
							"options": {
								"text": "This solution allows you to run one or multiple scripts on selected virtual machines in a resource group using managed Run Commands.",
								"link": {
									"label": "Microsoft Learn | Managed Run Commands",
									"uri": "https://learn.microsoft.com/en-us/azure/virtual-machines/windows/run-command-managed"
								}
							}
						},
						{
							"name": "selectionMode",
							"type": "Microsoft.Common.OptionsGroup",
							"label": "VM Selection",
							"toolTip": "Choose from list to pick VMs from a dropdown (limited to 50 by the ARM API). Use Name pattern to target VMs by prefix and index range, which is useful for large session host pools.",
							"defaultValue": "Choose from list",
							"constraints": {
								"allowedValues": [
									{
										"label": "Choose from list",
										"value": "list"
									},
									{
										"label": "Name pattern",
										"value": "pattern"
									}
								],
								"required": true
							}
						},
						{
							"name": "subscriptionsApi",
							"type": "Microsoft.Solutions.ArmApiControl",
							"request": {
								"method": "GET",
								"path": "/subscriptions?api-version=2022-12-01",
								"transforms": {
									"list": "value|[*].{label:displayName, value:id}"
								}
							}
						},
						{
							"name": "subscription",
							"type": "Microsoft.Common.DropDown",
							"label": "Subscription",
							"constraints": {
								"allowedValues": "[steps('basics').subscriptionsApi.transformed.list]",
								"required": true
							}
						},
						{
							"name": "resourceGroupsApi",
							"type": "Microsoft.Solutions.ArmApiControl",
							"condition": "[not(empty(steps('basics').subscription))]",
							"request": {
								"method": "GET",
								"path": "[concat(steps('basics').subscription, '/resourcegroups?api-version=2021-04-01')]"
							}
						},
						{
							"name": "resourceGroup",
							"type": "Microsoft.Common.DropDown",
							"label": "Resource Group",
							"toolTip": "Select the resource group containing the Virtual Machines",
							"multiLine": true,
							"constraints": {
								"allowedValues": "[map(steps('basics').resourceGroupsApi.value, (rg) => parse(concat('{\"label\":\"', rg.name, '\",\"description\":\"Location: ', rg.location, '\",\"value\":{\"id\":\"', rg.id, '\",\"location\":\"', rg.location, '\"}}')))]",
								"required": true
							}
						},
						{
							"name": "virtualMachinesApi",
							"type": "Microsoft.Solutions.ArmApiControl",
							"condition": "[and(equals(steps('basics').selectionMode, 'list'), not(empty(steps('basics').resourceGroup)))]",
							"request": {
								"method": "GET",
								"path": "[concat(steps('basics').resourceGroup.id, '/providers/Microsoft.Compute/virtualMachines?api-version=2024-07-01')]",
								"transforms": {
									"list": "value|[*].{label:name, value:name}"
								}
							}
						},
						{
							"name": "vmNames",
							"type": "Microsoft.Common.DropDown",
							"label": "Virtual Machines",
							"multiselect": true,
							"toolTip": "Select the virtual machine(s) on which to run the script.",
							"constraints": {
								"allowedValues": "[steps('basics').virtualMachinesApi.transformed.list]",
								"required": true
							},
							"visible": "[equals(steps('basics').selectionMode, 'list')]"
						},
						{
							"name": "vmPrefix",
							"type": "Microsoft.Common.TextBox",
							"label": "VM Name Prefix",
							"toolTip": "The prefix shared by all target VMs (e.g. 'avd-vm-' produces 'avd-vm-01', 'avd-vm-02', ...).",
							"constraints": {
								"required": true,
								"regex": "^[a-zA-Z][a-zA-Z0-9-]{0,19}$",
								"validationMessage": "Must start with a letter, use only letters, numbers, and hyphens, and be 1-20 characters."
							},
							"visible": "[equals(steps('basics').selectionMode, 'pattern')]"
						},
						{
							"name": "vmStartIndex",
							"type": "Microsoft.Common.TextBox",
							"label": "Start Index",
							"toolTip": "The first index in the range (inclusive).",
							"defaultValue": "1",
							"constraints": {
								"required": true,
								"regex": "^[0-9]{1,4}$",
								"validationMessage": "Enter a whole number between 0 and 9999."
							},
							"visible": "[equals(steps('basics').selectionMode, 'pattern')]"
						},
						{
							"name": "vmEndIndex",
							"type": "Microsoft.Common.TextBox",
							"label": "End Index",
							"toolTip": "The last index in the range (inclusive).",
							"defaultValue": "10",
							"constraints": {
								"required": true,
								"regex": "^[0-9]{1,4}$",
								"validationMessage": "Enter a whole number between 0 and 9999."
							},
							"visible": "[equals(steps('basics').selectionMode, 'pattern')]"
						},
						{
							"name": "vmIndexPadding",
							"type": "Microsoft.Common.TextBox",
							"label": "Index Padding",
							"toolTip": "Total digits in the index number. Use 2 for 01-99, 3 for 001-999.",
							"defaultValue": "2",
							"constraints": {
								"required": false,
								"regex": "^[1-9]$",
								"validationMessage": "Enter a single digit between 1 and 9."
							},
							"visible": "[equals(steps('basics').selectionMode, 'pattern')]"
						}
					]
				},
				{
					"name": "scripts",
					"label": "Scripts",
					"elements": [
						{
							"name": "source",
							"type": "Microsoft.Common.OptionsGroup",
							"label": "Script Source",
							"toolTip": "Select 'Paste in Content' to paste a single script inline. Select 'Storage Account' to run one or more scripts downloaded from a storage account using the wrapper script. Select 'URI' to run a publicly accessible .ps1 script by URL.",
							"constraints": {
								"allowedValues": [
									{
										"label": "Paste in Content",
										"value": "paste"
									},
									{
										"label": "Storage Account",
										"value": "storage"
									},
									{
										"label": "URI",
										"value": "uri"
									}
								],
								"required": true
							},
							"defaultValue": "Paste in Content"
						},
						{
							"name": "runCommandName",
							"type": "Microsoft.Common.TextBox",
							"label": "Run Command Name",
							"toolTip": "Provide a name for the run command resource. Alphanumeric characters only.",
							"constraints": {
								"required": true,
								"regex": "^[a-z0-9A-Z]{1,30}$",
								"validationMessage": "Only alphanumeric characters are allowed, and the value must be 1-30 characters long."
							},
							"visible": "[equals(steps('scripts').source, 'paste')]"
						},
						{
							"name": "scriptContent",
							"type": "Microsoft.Common.TextBox",
							"label": "Script Content",
							"multiLine": true,
							"toolTip": "Paste in the PowerShell script to run.",
							"constraints": {
								"required": true
							},
							"visible": "[equals(steps('scripts').source, 'paste')]"
						},
						{
							"name": "scriptUri",
							"type": "Microsoft.Common.TextBox",
							"label": "Script URI",
							"toolTip": "Provide the full URL to a .ps1 file. The run command will be named after the script filename (without extension).",
							"constraints": {
								"required": true,
								"regex": "^https?:\\/\\/[^\\s/$.?#].[^\\s]*\\/[^\\/]+\\.ps1$",
								"validationMessage": "Must be a valid URL ending in .ps1"
							},
							"visible": "[equals(steps('scripts').source, 'uri')]"
						},
						{
							"name": "uriUserAssignedIdentity",
							"type": "Microsoft.Solutions.ResourceSelector",
							"label": "User Assigned Identity (Optional)",
							"toolTip": "Select a User Assigned Identity with at least 'Storage Blob Data Reader' access if the script URI requires authentication.",
							"resourceType": "Microsoft.ManagedIdentity/userAssignedIdentities",
							"visible": "[equals(steps('scripts').source, 'uri')]"
						},
						{
							"name": "defineParameters",
							"type": "Microsoft.Common.CheckBox",
							"defaultValue": false,
							"label": "Define Script Parameters",
							"toolTip": "Define up to 5 parameters to pass to the script. These appear in plain text in your deployment history.",
							"visible": "[equals(steps('scripts').source, 'uri')]"
						},
						{
							"name": "parameters",
							"type": "Microsoft.Common.EditableGrid",
							"ariaLabel": "Script Parameters",
							"label": "Script Parameters",
							"visible": "[and(equals(steps('scripts').source, 'uri'), steps('scripts').defineParameters)]",
							"constraints": {
								"width": "Full",
								"rows": {
									"count": {
										"min": 1,
										"max": 5
									}
								},
								"columns": [
									{
										"id": "name",
										"header": "Name",
										"width": "1fr",
										"element": {
											"type": "Microsoft.Common.TextBox",
											"validations": [
												{
													"regex": "^[A-Za-z0-9]{1,24}$",
													"message": "Only alphanumerics are allowed up to 24 characters"
												}
											]
										}
									},
									{
										"id": "value",
										"header": "Value",
										"width": "1fr",
										"element": {
											"type": "Microsoft.Common.TextBox",
											"constraints": {
												"required": true
											}
										}
									}
								]
							}
						},
						{
							"name": "defineProtectedParameter",
							"type": "Microsoft.Common.CheckBox",
							"defaultValue": false,
							"label": "Define Protected Parameter",
							"toolTip": "Define a single protected (secret) parameter. The name and value will not appear in your deployment history.",
							"visible": "[equals(steps('scripts').source, 'uri')]"
						},
						{
							"name": "protectedParameter",
							"type": "Microsoft.Common.EditableGrid",
							"ariaLabel": "Protected Parameter",
							"label": "Protected Parameter",
							"visible": "[and(equals(steps('scripts').source, 'uri'), steps('scripts').defineProtectedParameter)]",
							"constraints": {
								"width": "Full",
								"rows": {
									"count": {
										"min": 1,
										"max": 1
									}
								},
								"columns": [
									{
										"id": "name",
										"header": "Name",
										"width": "1fr",
										"element": {
											"type": "Microsoft.Common.TextBox",
											"validations": [
												{
													"regex": "^[A-Za-z0-9]{1,24}$",
													"message": "Only alphanumerics are allowed up to 24 characters"
												}
											]
										}
									},
									{
										"id": "value",
										"header": "Value",
										"width": "1fr",
										"element": {
											"type": "Microsoft.Common.TextBox",
											"constraints": {
												"required": true
											}
										}
									}
								]
							}
						},
						{
							"name": "storageAccountIntro",
							"type": "Microsoft.Common.TextBlock",
							"visible": "[equals(steps('scripts').source, 'storage')]",
							"options": {
								"text": "A wrapper script automatically downloads and runs PowerShell scripts, cmd scripts, executables (exe), installers (msi), and zip files containing a PowerShell script at the root."
							}
						},
						{
							"name": "scriptsStorageAccount",
							"type": "Microsoft.Solutions.ResourceSelector",
							"label": "Storage Account",
							"toolTip": "Select the storage account where the scripts and artifacts are stored.",
							"resourceType": "Microsoft.storage/storageAccounts",
							"constraints": {
								"required": true
							},
							"visible": "[equals(steps('scripts').source, 'storage')]"
						},
						{
							"name": "scriptsContainersApi",
							"type": "Microsoft.Solutions.ArmApiControl",
							"condition": "[not(empty(steps('scripts').scriptsStorageAccount))]",
							"request": {
								"method": "GET",
								"path": "[concat(steps('scripts').scriptsStorageAccount.id, '/blobServices/default/containers?api-version=2023-01-01')]"
							}
						},
						{
							"name": "scriptsContainer",
							"type": "Microsoft.Common.DropDown",
							"label": "Container",
							"defaultValue": "",
							"toolTip": "Select the container where the scripts are stored.",
							"constraints": {
								"required": true,
								"allowedValues": "[map(steps('scripts').scriptsContainersApi.value, (container) => parse(concat('{\"label\":\"', container.name, '\",\"value\":\"', container.name, '\"}')))]"
							},
							"visible": "[equals(steps('scripts').source, 'storage')]"
						},
						{
							"name": "scriptsUserAssignedIdentity",
							"type": "Microsoft.Solutions.ResourceSelector",
							"label": "User-Assigned Identity",
							"toolTip": "Select a User Assigned Identity with at least 'Storage Blob Data Reader' access to the container selected above.",
							"resourceType": "Microsoft.ManagedIdentity/userAssignedIdentities",
							"visible": "[equals(steps('scripts').source, 'storage')]"
						},
						{
							"name": "scriptsGridIntro",
							"type": "Microsoft.Common.TextBlock",
							"visible": "[equals(steps('scripts').source, 'storage')]",
							"options": {
								"text": "Enter each script or artifact below. Name: the run command name (alphanumerics and dashes, max 24 characters). Blob Name or URI: the blob name in the container above, or a full URL to an external resource. Arguments: optional command-line arguments."
							}
						},
						{
							"name": "scripts",
							"type": "Microsoft.Common.EditableGrid",
							"ariaLabel": "Scripts",
							"label": "Scripts and Software",
							"visible": "[equals(steps('scripts').source, 'storage')]",
							"constraints": {
								"width": "Full",
								"rows": {
									"count": {
										"min": 1,
										"max": 25
									}
								},
								"columns": [
									{
										"id": "name",
										"header": "Name",
										"width": "1fr",
										"element": {
											"type": "Microsoft.Common.TextBox",
											"placeholder": "Example: vscode",
											"validations": [
												{
													"regex": "^[A-Za-z0-9-]{1,24}$",
													"message": "Only alphanumerics and dashes (-) are allowed up to 24 characters"
												}
											]
										}
									},
									{
										"id": "blobNameOrUri",
										"header": "Blob Name or URI",
										"width": "10fr",
										"element": {
											"type": "Microsoft.Common.TextBox",
											"placeholder": "Example: VSCodeSetup-x64-1.81.1.exe",
											"constraints": {
												"required": true
											}
										}
									},
									{
										"id": "arguments",
										"header": "Arguments",
										"width": "1fr",
										"element": {
											"type": "Microsoft.Common.TextBox",
											"placeholder": "Example: /verysilent /mergetasks='!runcode'",
											"constraints": {
												"required": false
											}
										}
									}
								]
							}
						},
						{
							"name": "timeout",
							"type": "Microsoft.Common.TextBox",
							"label": "Script timeout in seconds",
							"toolTip": "Optionally, enter the amount of seconds that the script will be allowed to run on the virtual machine before timing out.",
							"defaultValue": 5400,
							"constraints": {
								"regex": "^[0-9]{1,5}$",
								"required": false
							},
							"visible": "[or(equals(steps('scripts').source, 'paste'), equals(steps('scripts').source, 'uri'))]"
						},
						{
							"name": "logging",
							"type": "Microsoft.Common.Section",
							"label": "Logging",
							"visible": true,
							"elements": [
								{
									"name": "enable",
									"type": "Microsoft.Common.CheckBox",
									"label": "Enable Script Logging"
								},
								{
									"name": "storageAccount",
									"type": "Microsoft.Solutions.ResourceSelector",
									"label": "Storage Account",
									"toolTip": "Select an existing Storage Account.",
									"resourceType": "Microsoft.storage/storageAccounts",
									"constraints": {
										"required": true
									},
									"visible": "[steps('scripts').logging.enable]"
								},
								{
									"name": "containersApi",
									"type": "Microsoft.Solutions.ArmApiControl",
									"condition": "[not(empty(steps('scripts').logging.storageAccount))]",
									"request": {
										"method": "GET",
										"path": "[concat(steps('scripts').logging.storageAccount.id, '/blobServices/default/containers?api-version=2023-01-01')]"
									}
								},
								{
									"name": "container",
									"type": "Microsoft.Common.DropDown",
									"label": "Log Blob Container",
									"defaultValue": "",
									"toolTip": "Select the container where logs will be saved.",
									"constraints": {
										"required": true,
										"allowedValues": "[map(steps('scripts').logging.containersApi.value, (container) => parse(concat('{\"label\":\"', container.name, '\",\"value\":\"', container.name, '\"}')))]"
									},
									"visible": "[steps('scripts').logging.enable]"
								},
								{
									"name": "userAssignedIdentity",
									"type": "Microsoft.Solutions.ResourceSelector",
									"label": "User Assigned Identity",
									"toolTip": "Select an existing User Assigned Identity which has been assigned data plane rights of at least 'Storage Blob Data Writer' to the blob container selected above.",
									"resourceType": "Microsoft.ManagedIdentity/userAssignedIdentities",
									"visible": "[steps('scripts').logging.enable]"
								}
							]
						}
					]
				}
			]
		},
		"outputs": {
			"parameters": {
				"vmNames": "[if(equals(steps('basics').selectionMode, 'list'), steps('basics').vmNames, parse('[]'))]",
				"vmPrefix": "[if(equals(steps('basics').selectionMode, 'pattern'), steps('basics').vmPrefix, '')]",
				"vmStartIndex": "[if(equals(steps('basics').selectionMode, 'pattern'), int(steps('basics').vmStartIndex), 0)]",
				"vmEndIndex": "[if(equals(steps('basics').selectionMode, 'pattern'), int(steps('basics').vmEndIndex), 0)]",
				"vmIndexPadding": "[if(equals(steps('basics').selectionMode, 'pattern'), int(steps('basics').vmIndexPadding), 2)]",
				"runCommandName": "[if(equals(steps('scripts').source, 'paste'), steps('scripts').runCommandName, if(equals(steps('scripts').source, 'uri'), first(split(last(split(steps('scripts').scriptUri, '/')), '.')), ''))]",
				"scriptContent": "[if(equals(steps('scripts').source, 'paste'), steps('scripts').scriptContent, '')]",
				"scriptUri": "[if(equals(steps('scripts').source, 'uri'), steps('scripts').scriptUri, '')]",
				"scriptsUserAssignedIdentityResourceId": "[if(equals(steps('scripts').source, 'storage'), steps('scripts').scriptsUserAssignedIdentity.id, if(equals(steps('scripts').source, 'uri'), coalesce(steps('scripts').uriUserAssignedIdentity.id, ''), ''))]",
				"parameters": "[if(and(equals(steps('scripts').source, 'uri'), steps('scripts').defineParameters), steps('scripts').parameters, parse('[]'))]",
				"protectedParameter": "[if(and(equals(steps('scripts').source, 'uri'), steps('scripts').defineProtectedParameter), first(steps('scripts').protectedParameter), parse('{}'))]",
				"scriptsStorageAccountName": "[if(equals(steps('scripts').source, 'storage'), steps('scripts').scriptsStorageAccount.name, '')]",
				"scriptsContainerName": "[if(equals(steps('scripts').source, 'storage'), steps('scripts').scriptsContainer, '')]",
				"scripts": "[if(equals(steps('scripts').source, 'storage'), steps('scripts').scripts, parse('[]'))]",
				"logsStorageAccountName": "[if(steps('scripts').logging.enable, steps('scripts').logging.storageAccount.name, '')]",
				"logsContainerName": "[if(steps('scripts').logging.enable, steps('scripts').logging.container, '')]",
				"logsUserAssignedIdentityResourceId": "[if(steps('scripts').logging.enable, steps('scripts').logging.userAssignedIdentity.id, '')]",
				"timeoutInSeconds": "[if(or(equals(steps('scripts').source, 'paste'), equals(steps('scripts').source, 'uri')), steps('scripts').timeout, 5400)]"
			},
			"kind": "ResourceGroup",
			"location": "[steps('basics').resourceGroup.location]",
			"resourceGroupId": "[steps('basics').resourceGroup.id]"
		}
	}
}