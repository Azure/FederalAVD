{
  "$schema": "https://schema.management.azure.com/schemas/2021-09-09/uiFormDefinition.schema.json",
  "view": {
    "kind": "Form",
    "properties": {
      "title": "Automated Session Host Policy",
      "steps": [
        {
          "name": "scope",
          "label": "Deployment Scope",
          "elements": [
            {
              "name": "intro",
              "type": "Microsoft.Common.InfoBox",
              "options": {
                "style": "Info",
                "text": "Before creating the automated host pool, create the dedicated resource group that Session Host Configuration will use for its VMs. Deploy this add-on after creating the host pool with zero session hosts and before increasing its session host count. Select that same dedicated resource group as the policy scope."
              }
            },
            {
              "name": "subscriptionsApi",
              "type": "Microsoft.Solutions.ArmApiControl",
              "request": {
                "method": "GET",
                "path": "/subscriptions?api-version=2022-12-01"
              }
            },
            {
              "name": "subscription",
              "type": "Microsoft.Common.DropDown",
              "label": "Subscription",
              "constraints": {
                "allowedValues": "[map(steps('scope').subscriptionsApi.value, (sub) => parse(concat('{\"label\":\"', sub.displayName, '\",\"value\":{\"id\":\"', sub.id, '\",\"subscriptionId\":\"', sub.subscriptionId, '\"}}')))]",
                "required": true
              }
            },
            {
              "name": "hostPoolsApi",
              "type": "Microsoft.Solutions.ArmApiControl",
              "condition": "[not(empty(steps('scope').subscription))]",
              "request": {
                "method": "GET",
                "path": "[concat(steps('scope').subscription.id, '/providers/Microsoft.DesktopVirtualization/hostPools?api-version=2024-04-03')]"
              }
            },
            {
              "name": "hostPool",
              "type": "Microsoft.Common.DropDown",
              "label": "Automated Host Pool",
              "filter": true,
              "multiLine": true,
              "toolTip": "Select the automated host pool associated with this policy deployment. Its resource ID is applied as the cm-resource-parent tag to created resources.",
              "constraints": {
                "allowedValues": "[map(filter(steps('scope').hostPoolsApi.value, (hp) => equals(hp.properties.hostPoolType, 'Pooled')), (hp) => parse(concat('{\"label\":\"', hp.name, '\",\"description\":\"Resource Group: ', first(skip(split(hp.id, '/'), 4)), '\",\"value\":\"', hp.id, '\"}')))]",
                "required": true
              }
            },
            {
              "name": "locationsApi",
              "type": "Microsoft.Solutions.ArmApiControl",
              "condition": "[not(empty(steps('scope').subscription))]",
              "request": {
                "method": "GET",
                "path": "[concat(steps('scope').subscription.id, '/locations?api-version=2022-12-01')]"
              }
            },
            {
              "name": "location",
              "type": "Microsoft.Common.DropDown",
              "label": "Region",
              "constraints": {
                "allowedValues": "[map(steps('scope').locationsApi.value, (loc) => parse(concat('{\"label\":\"', loc.displayName, '\",\"value\":\"', loc.name, '\"}')))]",
                "required": true
              }
            },
            {
              "name": "resourceGroupsApi",
              "type": "Microsoft.Solutions.ArmApiControl",
              "condition": "[not(empty(steps('scope').subscription))]",
              "request": {
                "method": "GET",
                "path": "[concat(steps('scope').subscription.id, '/resourcegroups?api-version=2024-03-01')]"
              }
            },
            {
              "name": "sessionHostResourceGroup",
              "type": "Microsoft.Common.DropDown",
              "label": "Session Host Resource Group",
              "toolTip": "Select the existing dedicated resource group configured as the Session Host Configuration VM resource group.",
              "constraints": {
                "allowedValues": "[map(steps('scope').resourceGroupsApi.value, (rg) => parse(concat('{\"label\":\"', rg.name, '\",\"description\":\"Location: ', rg.location, '\",\"value\":\"', rg.name, '\"}')))]",
                "required": true
              }
            },
            {
              "name": "createPolicyResourceGroup",
              "type": "Microsoft.Common.CheckBox",
              "label": "Create a policy resource group",
              "defaultValue": false,
              "toolTip": "Create a resource group for the policy remediation managed identity and optional Disk Encryption Set."
            },
            {
              "name": "existingPolicyResourceGroup",
              "type": "Microsoft.Common.DropDown",
              "label": "Policy Resource Group",
              "visible": "[not(steps('scope').createPolicyResourceGroup)]",
              "constraints": {
                "allowedValues": "[map(steps('scope').resourceGroupsApi.value, (rg) => parse(concat('{\"label\":\"', rg.name, '\",\"description\":\"Location: ', rg.location, '\",\"value\":\"', rg.name, '\"}')))]",
                "required": true
              }
            },
            {
              "name": "newPolicyResourceGroupName",
              "type": "Microsoft.Common.TextBox",
              "label": "New Policy Resource Group Name",
              "visible": "[steps('scope').createPolicyResourceGroup]",
              "constraints": {
                "required": true,
                "regex": "^[a-zA-Z0-9._()\\-]{1,90}$",
                "validationMessage": "Enter a valid resource group name."
              }
            },
            {
              "name": "policyIdentityName",
              "type": "Microsoft.Common.TextBox",
              "label": "Policy Identity Name",
              "defaultValue": "[concat('id-avd-', last(split(steps('scope').hostPool, '/')), '-policy')]",
              "constraints": { "required": true }
            }
          ]
        },
        {
          "name": "securityMonitoring",
          "label": "Encryption and Monitoring",
          "elements": [
            {
              "name": "diskEncryptionMode",
              "type": "Microsoft.Common.DropDown",
              "label": "Session Host Disk Encryption",
              "defaultValue": "Platform-managed keys",
              "constraints": {
                "required": true,
                "allowedValues": [
                  { "label": "Platform-managed keys", "value": "None" },
                  { "label": "Create a Disk Encryption Set", "value": "Create" },
                  { "label": "Use an existing Disk Encryption Set", "value": "Existing" }
                ]
              }
            },
            {
              "name": "encryptionKeyVault",
              "type": "Microsoft.Solutions.ResourceSelector",
              "label": "Encryption Key Vault",
              "resourceType": "Microsoft.KeyVault/vaults",
              "toolTip": "Select an existing RBAC-enabled Key Vault where the disk encryption key will be created. HSM modes require a Premium Key Vault.",
              "visible": "[equals(steps('securityMonitoring').diskEncryptionMode, 'Create')]",
              "constraints": { "required": true },
              "scope": {
                "subscriptionId": "[steps('scope').subscription.subscriptionId]",
                "location": "[steps('scope').location]"
              }
            },
            {
              "name": "keyManagementDisks",
              "type": "Microsoft.Common.DropDown",
              "label": "Customer-Managed Key Mode",
              "defaultValue": "Customer-managed HSM key",
              "visible": "[equals(steps('securityMonitoring').diskEncryptionMode, 'Create')]",
              "constraints": {
                "required": true,
                "allowedValues": [
                  { "label": "Customer-managed software key", "value": "CustomerManaged" },
                  { "label": "Customer-managed HSM key", "value": "CustomerManagedHSM" },
                  { "label": "Platform and customer-managed software keys", "value": "PlatformManagedAndCustomerManaged" },
                  { "label": "Platform and customer-managed HSM keys", "value": "PlatformManagedAndCustomerManagedHSM" }
                ]
              }
            },
            {
              "name": "diskEncryptionKeyName",
              "type": "Microsoft.Common.TextBox",
              "label": "Disk Encryption Key Name",
              "defaultValue": "key-avd-session-host-disk",
              "visible": "[equals(steps('securityMonitoring').diskEncryptionMode, 'Create')]",
              "constraints": {
                "required": true,
                "regex": "^[a-zA-Z0-9-]{1,127}$",
                "validationMessage": "Use 1-127 letters, numbers, or dashes."
              }
            },
            {
              "name": "diskEncryptionSetName",
              "type": "Microsoft.Common.TextBox",
              "label": "Disk Encryption Set Name",
              "defaultValue": "des-avd-session-host",
              "visible": "[equals(steps('securityMonitoring').diskEncryptionMode, 'Create')]",
              "constraints": {
                "required": true,
                "regex": "^[a-zA-Z0-9_-]{1,80}$",
                "validationMessage": "Use 1-80 letters, numbers, dashes, or underscores."
              }
            },
            {
              "name": "keyExpirationInDays",
              "type": "Microsoft.Common.Slider",
              "label": "Encryption Key Rotation (in Days)",
              "defaultValue": 180,
              "showStepMarkers": false,
              "toolTip": "Days before a new key version is automatically generated in the selected Key Vault.",
              "min": 30,
              "max": 180,
              "visible": "[equals(steps('securityMonitoring').diskEncryptionMode, 'Create')]",
              "constraints": { "required": true }
            },
            {
              "name": "diskEncryptionSetsApi",
              "type": "Microsoft.Solutions.ArmApiControl",
              "condition": "[and(equals(steps('securityMonitoring').diskEncryptionMode, 'Existing'), not(empty(steps('scope').subscription)))]",
              "request": {
                "method": "GET",
                "path": "[concat(steps('scope').subscription.id, '/providers/Microsoft.Compute/diskEncryptionSets?api-version=2024-03-02')]"
              }
            },
            {
              "name": "diskEncryptionSet",
              "type": "Microsoft.Common.DropDown",
              "label": "Disk Encryption Set",
              "multiLine": true,
              "visible": "[equals(steps('securityMonitoring').diskEncryptionMode, 'Existing')]",
              "constraints": {
                "allowedValues": "[map(steps('securityMonitoring').diskEncryptionSetsApi.value, (des) => parse(concat('{\"label\":\"', des.name, '\",\"description\":\"Resource Group: ', first(skip(split(des.id, '/'), 4)), ', Location: ', des.location, '\",\"value\":\"', des.id, '\"}')))]",
                "required": true
              }
            },
            {
              "name": "integrityMonitoring",
              "type": "Microsoft.Common.CheckBox",
              "label": "Deploy Guest Attestation for integrity monitoring",
              "defaultValue": true
            },
            {
              "name": "encryptionAtHost",
              "type": "Microsoft.Common.CheckBox",
              "label": "Enable encryption at host",
              "defaultValue": true
            },
            {
              "name": "diskSizeGB",
              "type": "Microsoft.Common.TextBox",
              "label": "OS Disk Size (GB)",
              "defaultValue": "0",
              "toolTip": "Use 0 to preserve the image default size.",
              "constraints": {
                "required": true,
                "regex": "^[0-9]+$",
                "validationMessage": "Enter zero or a positive whole number."
              }
            },
            {
              "name": "enableAcceleratedNetworking",
              "type": "Microsoft.Common.CheckBox",
              "label": "Enable accelerated networking",
              "defaultValue": true
            },
            {
              "name": "disableManagedDiskPublicNetworkAccess",
              "type": "Microsoft.Common.CheckBox",
              "label": "Disable public network access on managed disks",
              "defaultValue": false,
              "toolTip": "Sets public network access to Disabled and network access policy to DenyAll. No Disk Access resource is created or associated."
            },
            {
              "name": "virtualMachinesTimeZone",
              "type": "Microsoft.Common.TextBox",
              "label": "Session Host Time Zone",
              "defaultValue": "Eastern Standard Time",
              "constraints": { "required": true }
            },
            {
              "name": "enableMonitoring",
              "type": "Microsoft.Common.CheckBox",
              "label": "Enable Azure Monitor Agent and AVD Insights data collection",
              "defaultValue": true
            },
            {
              "name": "dataCollectionRulesApi",
              "type": "Microsoft.Solutions.ArmApiControl",
              "condition": "[and(steps('securityMonitoring').enableMonitoring, not(empty(steps('scope').subscription)))]",
              "request": {
                "method": "GET",
                "path": "[concat(steps('scope').subscription.id, '/providers/Microsoft.Insights/dataCollectionRules?api-version=2023-03-11')]"
              }
            },
            {
              "name": "dataCollectionRule",
              "type": "Microsoft.Common.DropDown",
              "label": "AVD Insights Data Collection Rule",
              "multiLine": true,
              "visible": "[steps('securityMonitoring').enableMonitoring]",
              "constraints": {
                "allowedValues": "[map(steps('securityMonitoring').dataCollectionRulesApi.value, (dcr) => parse(concat('{\"label\":\"', dcr.name, '\",\"description\":\"Resource Group: ', first(skip(split(dcr.id, '/'), 4)), ', Location: ', dcr.location, '\",\"value\":\"', dcr.id, '\"}')))]",
                "required": true
              }
            },
            {
              "name": "dataCollectionEndpointsApi",
              "type": "Microsoft.Solutions.ArmApiControl",
              "condition": "[and(steps('securityMonitoring').enableMonitoring, not(empty(steps('scope').subscription)))]",
              "request": {
                "method": "GET",
                "path": "[concat(steps('scope').subscription.id, '/providers/Microsoft.Insights/dataCollectionEndpoints?api-version=2023-03-11')]"
              }
            },
            {
              "name": "dataCollectionEndpoint",
              "type": "Microsoft.Common.DropDown",
              "label": "Data Collection Endpoint",
              "multiLine": true,
              "visible": "[steps('securityMonitoring').enableMonitoring]",
              "constraints": {
                "allowedValues": "[map(steps('securityMonitoring').dataCollectionEndpointsApi.value, (dce) => parse(concat('{\"label\":\"', dce.name, '\",\"description\":\"Resource Group: ', first(skip(split(dce.id, '/'), 4)), ', Location: ', dce.location, '\",\"value\":\"', dce.id, '\"}')))]",
                "required": false
              }
            },
            {
              "name": "scopeMonitoringToSupportedImages",
              "type": "Microsoft.Common.CheckBox",
              "label": "Restrict monitoring to supported Windows images",
              "defaultValue": true,
              "visible": "[steps('securityMonitoring').enableMonitoring]"
            },
            {
              "name": "additionalWindowsImageResourceIds",
              "type": "Microsoft.Common.EditableGrid",
              "label": "Additional Custom Image Resource IDs",
              "ariaLabel": "Additional Custom Image Resource IDs",
              "visible": "[steps('securityMonitoring').enableMonitoring]",
              "constraints": {
                "width": "Full",
                "rows": { "count": { "min": 0, "max": 20 } },
                "columns": [
                  {
                    "id": "resourceId",
                    "header": "Image Resource ID",
                    "width": "1fr",
                    "element": {
                      "type": "Microsoft.Common.TextBox",
                      "constraints": { "required": true }
                    }
                  }
                ]
              }
            }
          ]
        },
        {
          "name": "fslogix",
          "label": "FSLogix Configuration",
          "elements": [
            {
              "name": "configureFSLogix",
              "type": "Microsoft.Common.CheckBox",
              "label": "Configure FSLogix on session hosts",
              "defaultValue": false
            },
            {
              "name": "identitySolution",
              "type": "Microsoft.Common.DropDown",
              "label": "Identity Solution",
              "defaultValue": "Storage Account Keys",
              "visible": "[steps('fslogix').configureFSLogix]",
              "constraints": {
                "required": true,
                "allowedValues": [
                  { "label": "Active Directory Domain Services", "value": "ActiveDirectoryDomainServices" },
                  { "label": "Microsoft Entra Domain Services", "value": "EntraDomainServices" },
                  { "label": "Microsoft Entra Kerberos (hybrid identities)", "value": "EntraKerberos-Hybrid" },
                  { "label": "Microsoft Entra Kerberos (cloud-only identities)", "value": "EntraKerberos-CloudOnly" },
                  { "label": "Storage Account Keys", "value": "EntraId" }
                ]
              }
            },
            {
              "name": "storageService",
              "type": "Microsoft.Common.DropDown",
              "label": "Storage Service",
              "defaultValue": "Azure Files",
              "visible": "[steps('fslogix').configureFSLogix]",
              "constraints": {
                "required": true,
                "allowedValues": [
                  { "label": "Azure Files", "value": "AzureFiles" },
                  { "label": "Azure NetApp Files", "value": "AzureNetAppFiles" }
                ]
              }
            },
            {
              "name": "containerType",
              "type": "Microsoft.Common.DropDown",
              "label": "FSLogix Container Type(s)",
              "defaultValue": "Profile Container",
              "visible": "[steps('fslogix').configureFSLogix]",
              "constraints": {
                "required": true,
                "allowedValues": [
                  { "label": "Cloud Cache, Profile Container", "value": "CloudCacheProfileContainer" },
                  { "label": "Cloud Cache, Profile and Office Container", "value": "CloudCacheProfileOfficeContainer" },
                  { "label": "Profile Container", "value": "ProfileContainer" },
                  { "label": "Profile and Office Container", "value": "ProfileOfficeContainer" }
                ]
              }
            },
            {
              "name": "profileSizeInMBs",
              "type": "Microsoft.Common.TextBox",
              "label": "FSLogix VHD Size (MB)",
              "defaultValue": "30000",
              "visible": "[steps('fslogix').configureFSLogix]",
              "constraints": {
                "required": true,
                "regex": "^[1-9][0-9]*$",
                "validationMessage": "Enter a positive whole number."
              }
            },
            {
              "name": "localStorageAccountResourceIds",
              "type": "Microsoft.Common.EditableGrid",
              "label": "Local Azure Files Storage Account Resource IDs",
              "ariaLabel": "Local Azure Files Storage Account Resource IDs",
              "visible": "[and(steps('fslogix').configureFSLogix, equals(steps('fslogix').storageService, 'AzureFiles'))]",
              "constraints": {
                "width": "Full",
                "rows": { "count": { "min": 1, "max": 2 } },
                "columns": [
                  { "id": "resourceId", "header": "Resource ID", "width": "1fr", "element": { "type": "Microsoft.Common.TextBox", "constraints": { "required": true } } }
                ]
              }
            },
            {
              "name": "remoteStorageAccountResourceIds",
              "type": "Microsoft.Common.EditableGrid",
              "label": "Remote Azure Files Storage Account Resource IDs",
              "ariaLabel": "Remote Azure Files Storage Account Resource IDs",
              "visible": "[and(steps('fslogix').configureFSLogix, equals(steps('fslogix').storageService, 'AzureFiles'), contains(steps('fslogix').containerType, 'CloudCache'))]",
              "constraints": {
                "width": "Full",
                "rows": { "count": { "min": 0, "max": 2 } },
                "columns": [
                  { "id": "resourceId", "header": "Resource ID", "width": "1fr", "element": { "type": "Microsoft.Common.TextBox", "constraints": { "required": true } } }
                ]
              }
            },
            {
              "name": "localNetAppServerFqdns",
              "type": "Microsoft.Common.EditableGrid",
              "label": "Local Azure NetApp Files SMB Server FQDNs",
              "ariaLabel": "Local Azure NetApp Files SMB Server FQDNs",
              "visible": "[and(steps('fslogix').configureFSLogix, equals(steps('fslogix').storageService, 'AzureNetAppFiles'))]",
              "constraints": {
                "width": "Full",
                "rows": { "count": { "min": 1, "max": 20 } },
                "columns": [
                  { "id": "fqdn", "header": "SMB Server FQDN", "width": "1fr", "element": { "type": "Microsoft.Common.TextBox", "constraints": { "required": true } } }
                ]
              }
            },
            {
              "name": "remoteNetAppServerFqdns",
              "type": "Microsoft.Common.EditableGrid",
              "label": "Remote Azure NetApp Files SMB Server FQDNs",
              "ariaLabel": "Remote Azure NetApp Files SMB Server FQDNs",
              "visible": "[and(steps('fslogix').configureFSLogix, equals(steps('fslogix').storageService, 'AzureNetAppFiles'), contains(steps('fslogix').containerType, 'CloudCache'))]",
              "constraints": {
                "width": "Full",
                "rows": { "count": { "min": 0, "max": 20 } },
                "columns": [
                  { "id": "fqdn", "header": "SMB Server FQDN", "width": "1fr", "element": { "type": "Microsoft.Common.TextBox", "constraints": { "required": true } } }
                ]
              }
            },
            {
              "name": "objectSpecificSettingsGroups",
              "type": "Microsoft.Common.EditableGrid",
              "label": "Object-Specific Settings Group Names",
              "ariaLabel": "Object-Specific Settings Group Names",
              "visible": "[steps('fslogix').configureFSLogix]",
              "constraints": {
                "width": "Full",
                "rows": { "count": { "min": 0, "max": 20 } },
                "columns": [
                  { "id": "name", "header": "Group Name", "width": "1fr", "element": { "type": "Microsoft.Common.TextBox", "constraints": { "required": true } } }
                ]
              }
            }
          ]
        },
        {
          "name": "customizations",
          "label": "Session Host Customizations",
          "elements": [
            {
              "name": "enableCustomizations",
              "type": "Microsoft.Common.CheckBox",
              "label": "Add custom scripts or software",
              "defaultValue": false
            },
            {
              "name": "storageAccountsApi",
              "type": "Microsoft.Solutions.ArmApiControl",
              "condition": "[steps('customizations').enableCustomizations]",
              "request": {
                "method": "GET",
                "path": "[concat(steps('scope').subscription.id, '/providers/Microsoft.Storage/storageAccounts?api-version=2023-05-01')]"
              }
            },
            {
              "name": "storageAccount",
              "type": "Microsoft.Common.DropDown",
              "label": "Artifacts Storage Account",
              "visible": "[steps('customizations').enableCustomizations]",
              "constraints": {
                "allowedValues": "[map(steps('customizations').storageAccountsApi.value, (sa) => parse(concat('{\"label\":\"', sa.name, '\",\"description\":\"Location: ', sa.location, ', Resource Group: ', first(skip(split(sa.id, '/'), 4)), '\",\"value\":{\"id\":\"', sa.id, '\",\"blobEndpoint\":\"', sa.properties.primaryEndpoints.blob, '\"}}')))]",
                "required": false
              }
            },
            {
              "name": "containerName",
              "type": "Microsoft.Common.TextBox",
              "label": "Artifacts Container Name",
              "defaultValue": "artifacts",
              "visible": "[steps('customizations').enableCustomizations]",
              "constraints": { "required": false }
            },
            {
              "name": "managedIdentity",
              "type": "Microsoft.Solutions.ResourceSelector",
              "label": "Storage Access User Assigned Identity",
              "resourceType": "Microsoft.ManagedIdentity/userAssignedIdentities",
              "visible": "[steps('customizations').enableCustomizations]",
              "constraints": { "required": true },
              "scope": { "subscriptionId": "[steps('scope').subscription.subscriptionId]" }
            },
            {
              "name": "customScripts",
              "type": "Microsoft.Common.EditableGrid",
              "ariaLabel": "Customizations",
              "label": "Customizations",
              "visible": "[steps('customizations').enableCustomizations]",
              "constraints": {
                "width": "Full",
                "rows": { "count": { "min": 1, "max": 10 } },
                "columns": [
                  {
                    "id": "name",
                    "header": "Name",
                    "width": "1fr",
                    "element": {
                      "type": "Microsoft.Common.TextBox",
                      "constraints": {
                        "required": true,
                        "validations": [
                          { "regex": "^(?![_-])[A-Za-z0-9_-]{1,13}(?<![_-])$", "message": "Use 1-13 letters, numbers, dashes, or underscores; do not start or end with a dash or underscore." }
                        ]
                      }
                    }
                  },
                  { "id": "blobNameOrUri", "header": "Blob Name or URI", "width": "2fr", "element": { "type": "Microsoft.Common.TextBox", "constraints": { "required": true } } },
                  { "id": "arguments", "header": "Arguments", "width": "1fr", "element": { "type": "Microsoft.Common.TextBox", "constraints": { "required": false } } }
                ]
              }
            }
          ]
        },
        {
          "name": "tags",
          "label": "Tags",
          "elements": [
            {
              "name": "tags",
              "type": "Microsoft.Common.TagsByResource",
              "resources": [
                "Microsoft.Resources/resourceGroups",
                "Microsoft.ManagedIdentity/userAssignedIdentities",
                "Microsoft.Compute/diskEncryptionSets"
              ]
            }
          ]
        }
      ]
    },
    "outputs": {
      "parameters": {
        "location": "[steps('scope').location]",
        "hostPoolResourceId": "[steps('scope').hostPool]",
        "sessionHostResourceGroupName": "[steps('scope').sessionHostResourceGroup]",
        "policyResourceGroupName": "[if(steps('scope').createPolicyResourceGroup, steps('scope').newPolicyResourceGroupName, steps('scope').existingPolicyResourceGroup)]",
        "createPolicyResourceGroup": "[steps('scope').createPolicyResourceGroup]",
        "policyIdentityName": "[steps('scope').policyIdentityName]",
        "deployDiskEncryptionSet": "[equals(steps('securityMonitoring').diskEncryptionMode, 'Create')]",
        "diskEncryptionSetResourceId": "[if(equals(steps('securityMonitoring').diskEncryptionMode, 'Existing'), steps('securityMonitoring').diskEncryptionSet, '')]",
        "encryptionKeyVaultResourceId": "[if(equals(steps('securityMonitoring').diskEncryptionMode, 'Create'), steps('securityMonitoring').encryptionKeyVault.id, '')]",
        "keyManagementDisks": "[steps('securityMonitoring').keyManagementDisks]",
        "diskEncryptionKeyName": "[steps('securityMonitoring').diskEncryptionKeyName]",
        "diskEncryptionSetName": "[steps('securityMonitoring').diskEncryptionSetName]",
        "keyExpirationInDays": "[steps('securityMonitoring').keyExpirationInDays]",
        "enableMonitoring": "[steps('securityMonitoring').enableMonitoring]",
        "dataCollectionRuleResourceId": "[if(steps('securityMonitoring').enableMonitoring, steps('securityMonitoring').dataCollectionRule, '')]",
        "dataCollectionEndpointResourceId": "[coalesce(steps('securityMonitoring').dataCollectionEndpoint, '')]",
        "scopeMonitoringToSupportedImages": "[steps('securityMonitoring').scopeMonitoringToSupportedImages]",
        "additionalWindowsImageResourceIds": "[map(steps('securityMonitoring').additionalWindowsImageResourceIds, (image) => image.resourceId)]",
        "integrityMonitoring": "[steps('securityMonitoring').integrityMonitoring]",
        "encryptionAtHost": "[steps('securityMonitoring').encryptionAtHost]",
        "diskSizeGB": "[steps('securityMonitoring').diskSizeGB]",
        "enableAcceleratedNetworking": "[steps('securityMonitoring').enableAcceleratedNetworking]",
        "disableManagedDiskPublicNetworkAccess": "[steps('securityMonitoring').disableManagedDiskPublicNetworkAccess]",
        "virtualMachinesTimeZone": "[steps('securityMonitoring').virtualMachinesTimeZone]",
        "configureFSLogix": "[steps('fslogix').configureFSLogix]",
        "fslogixConfiguration": "[parse(concat('{\"identitySolution\":\"', steps('fslogix').identitySolution, '\",\"storageService\":\"', steps('fslogix').storageService, '\",\"containerType\":\"', steps('fslogix').containerType, '\",\"fileShareNames\":', string(if(contains(steps('fslogix').containerType, 'OfficeContainer'), parse('[\"profile-containers\",\"office-containers\"]'), parse('[\"profile-containers\"]'))), ',\"localStorageAccountResourceIds\":', string(if(equals(steps('fslogix').storageService, 'AzureFiles'), map(steps('fslogix').localStorageAccountResourceIds, (item) => item.resourceId), parse('[]'))), ',\"remoteStorageAccountResourceIds\":', string(if(and(equals(steps('fslogix').storageService, 'AzureFiles'), contains(steps('fslogix').containerType, 'CloudCache')), map(steps('fslogix').remoteStorageAccountResourceIds, (item) => item.resourceId), parse('[]'))), ',\"localNetAppServerFqdns\":', string(if(equals(steps('fslogix').storageService, 'AzureNetAppFiles'), map(steps('fslogix').localNetAppServerFqdns, (item) => item.fqdn), parse('[]'))), ',\"remoteNetAppServerFqdns\":', string(if(and(equals(steps('fslogix').storageService, 'AzureNetAppFiles'), contains(steps('fslogix').containerType, 'CloudCache')), map(steps('fslogix').remoteNetAppServerFqdns, (item) => item.fqdn), parse('[]'))), ',\"objectSpecificSettingsGroups\":', string(map(steps('fslogix').objectSpecificSettingsGroups, (group) => group.name)), ',\"profileSizeInMBs\":', steps('fslogix').profileSizeInMBs, '}'))]",
        "artifactsContainerUri": "[if(and(steps('customizations').enableCustomizations, not(empty(steps('customizations').storageAccount))), concat(steps('customizations').storageAccount.blobEndpoint, steps('customizations').containerName), '')]",
        "artifactsUserAssignedIdentityResourceId": "[if(steps('customizations').enableCustomizations, steps('customizations').managedIdentity.id, '')]",
        "sessionHostCustomizations": "[if(steps('customizations').enableCustomizations, steps('customizations').customScripts, parse('[]'))]",
        "tags": "[steps('tags').tags]"
      },
      "location": "[steps('scope').location]"
    }
  }
}