{
    "$schema": "https://schema.management.azure.com/schemas/2021-09-09/uiFormDefinition.schema.json",
    "view": {
        "kind": "Form",
        "properties": {
            "title": "FSLogix Storage Quota Manager",
            "steps": [
                {
                    "name": "basics",
                    "label": "Deployment Basics",
                    "elements": [
                        {
                            "name": "infoBox1",
                            "type": "Microsoft.Common.TextBlock",
                            "visible": true,
                            "options": {
                                "text": "Deploys an Azure Automation Account with a PowerShell runbook that automatically increases or decreases FSLogix Azure Files Premium share quotas to keep provisioned capacity close to actual usage."
                            }
                        },
                        {
                            "name": "resourceScope",
                            "type": "Microsoft.Common.ResourceScope",
                            "subscription": {
                                "resourceProviders": [
                                    "Microsoft.Automation/automationAccounts"
                                ]
                            },
                            "resourceGroup": {
                                "allowExisting": true,
                                "toolTip": "Resource group where the Automation Account will be deployed. This is typically an operations or management resource group, not the FSLogix storage resource group."
                            },
                            "location": {
                                "label": "Region",
                                "toolTip": "Select the Azure region for the Automation Account.",
                                "resourceTypes": [
                                    "Microsoft.Automation/automationAccounts"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "storage",
                    "label": "Storage Settings",
                    "elements": [
                        {
                            "name": "infoStorage",
                            "type": "Microsoft.Common.TextBlock",
                            "visible": true,
                            "options": {
                                "text": "Select the resource group containing your FSLogix Azure Files Premium storage accounts. This is typically different from the resource group selected on the Basics page. The Automation Account managed identity will be granted Storage Account Contributor on this resource group."
                            }
                        },
                        {
                            "name": "storageResourceGroupsApi",
                            "type": "Microsoft.Solutions.ArmApiControl",
                            "request": {
                                "method": "GET",
                                "path": "[concat(steps('basics').resourceScope.subscription.id, '/resourcegroups?api-version=2021-04-01')]"
                            }
                        },
                        {
                            "name": "storageResourceGroup",
                            "type": "Microsoft.Common.DropDown",
                            "label": "Storage Resource Group",
                            "toolTip": "Resource group containing the FSLogix storage accounts to monitor. The runbook will manage all Azure Files Premium shares found in this group.",
                            "constraints": {
                                "required": true,
                                "allowedValues": "[map(steps('storage').storageResourceGroupsApi.value, (rg) => parse(concat('{\"label\":\"', rg.name, '\",\"description\":\"', rg.location, '\",\"value\":\"', rg.id, '\"}')))]"
                            }
                        },
                        {
                            "name": "storageAccountsApi",
                            "type": "Microsoft.Solutions.ArmApiControl",
                            "condition": "[not(empty(steps('storage').storageResourceGroup))]",
                            "request": {
                                "method": "GET",
                                "path": "[concat(steps('storage').storageResourceGroup, '/providers/Microsoft.Storage/storageAccounts?api-version=2023-05-01')]"
                            }
                        },
                        {
                            "name": "storageAccountsPreview",
                            "type": "Microsoft.Common.InfoBox",
                            "visible": "[not(empty(steps('storage').storageResourceGroup))]",
                            "options": {
                                "style": "Info",
                                "text": "[if(empty(coalesce(steps('storage').storageAccountsApi.value, parse('[]'))), 'No storage accounts found in the selected resource group.', if(empty(filter(coalesce(steps('storage').storageAccountsApi.value, parse('[]')), (sa) => startsWith(sa.name, 'fslogix'))), concat('Storage accounts found but none start with \"fslogix\". Automation Account will be named: aa-sqm-{unique}-{regionAbbr}. Use the name override on the Advanced page if needed.'), concat('FSLogix storage detected: ', first(map(filter(coalesce(steps('storage').storageAccountsApi.value, parse('[]')), (sa) => startsWith(sa.name, 'fslogix')), (sa) => sa.name)), '. Automation Account will be named: aa-sqm-', substring(first(map(filter(coalesce(steps('storage').storageAccountsApi.value, parse('[]')), (sa) => startsWith(sa.name, 'fslogix')), (sa) => sa.name)), 7), '-{regionAbbr}.')))]"
                            }
                        },
                        {
                            "name": "scheduleFrequencyMinutes",
                            "type": "Microsoft.Common.DropDown",
                            "label": "Check Frequency",
                            "defaultValue": "Every 15 minutes",
                            "toolTip": "How often the runbook checks storage account share usage and adjusts quotas.",
                            "constraints": {
                                "required": true,
                                "allowedValues": [
                                    {
                                        "label": "Every 15 minutes",
                                        "value": 15
                                    },
                                    {
                                        "label": "Every 30 minutes",
                                        "value": 30
                                    },
                                    {
                                        "label": "Every 60 minutes",
                                        "value": 60
                                    }
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "monitoring",
                    "label": "Monitoring",
                    "elements": [
                        {
                            "name": "enableMonitoring",
                            "type": "Microsoft.Common.CheckBox",
                            "label": "Enable Monitoring",
                            "defaultValue": true,
                            "toolTip": "Send Automation Account job logs and metrics to a Log Analytics Workspace."
                        },
                        {
                            "name": "logAnalyticsWorkspace",
                            "type": "Microsoft.Solutions.ResourceSelector",
                            "label": "Log Analytics Workspace",
                            "resourceType": "Microsoft.OperationalInsights/workspaces",
                            "visible": "[steps('monitoring').enableMonitoring]"
                        }
                    ]
                },
                {
                    "name": "advanced",
                    "label": "Advanced",
                    "elements": [
                        {
                            "name": "infoBox1",
                            "type": "Microsoft.Common.InfoBox",
                            "options": {
                                "style": "Info",
                                "text": "Use this page to override the Automation Account name, provide a custom runbook URI, or configure the job schedule link. Leave all fields at their defaults for a standard first deployment."
                            }
                        },
                        {
                            "name": "namingSection",
                            "type": "Microsoft.Common.Section",
                            "label": "Resource Name Override",
                            "elements": [
                                {
                                    "name": "defaultNamePreview",
                                    "type": "Microsoft.Common.TextBlock",
                                    "visible": true,
                                    "options": {
                                        "text": "[concat('Default Automation Account name: ', if(empty(steps('storage').identifier), 'aa-sqm-{regionAbbr}', concat('aa-sqm-', steps('storage').identifier, '-{regionAbbr}')))]"
                                    }
                                },
                                {
                                    "name": "enableNameOverride",
                                    "type": "Microsoft.Common.CheckBox",
                                    "label": "Override Automation Account Name",
                                    "defaultValue": false,
                                    "toolTip": "Check to provide an explicit Automation Account name instead of the automatically derived name."
                                },
                                {
                                    "name": "automationAccountNameOverride",
                                    "type": "Microsoft.Common.TextBox",
                                    "visible": "[steps('advanced').namingSection.enableNameOverride]",
                                    "label": "Automation Account Name",
                                    "placeholder": "[if(empty(steps('storage').identifier), 'aa-sqm-{regionAbbr}', concat('aa-sqm-', steps('storage').identifier, '-{regionAbbr}'))]",
                                    "toolTip": "Optional. Explicit name for the Automation Account. Must be 6-128 characters, alphanumeric and hyphens.",
                                    "constraints": {
                                        "required": false,
                                        "validations": [
                                            {
                                                "regex": "^$|^[a-zA-Z0-9-]{6,128}$",
                                                "message": "Automation Account name must be 6-128 characters, alphanumeric and hyphens only."
                                            }
                                        ]
                                    }
                                }
                            ]
                        },
                        {
                            "name": "runbookSection",
                            "type": "Microsoft.Common.Section",
                            "label": "Runbook Content",
                            "elements": [
                                {
                                    "name": "runbookInfo",
                                    "type": "Microsoft.Common.InfoBox",
                                    "options": {
                                        "style": "Info",
                                        "text": "The Azure Automation service downloads the runbook directly from the URI below during deployment. The default URI points to the FederalAVD GitHub repository and works for all clouds including Azure Government.\n\nAIR-GAPPED ENVIRONMENTS ONLY (Azure Government Secret / Top Secret)\n\nIn air-gapped clouds, Azure infrastructure cannot reach the public internet, so the default GitHub URI will fail at deploy time. If deploying to an air-gapped environment:\n1. Clear this field entirely (leave it blank).\n2. Deploy the template. The runbook will be created in an unpublished (New) state; the schedule is configured but no jobs will run until it is published.\n3. After deployment, publish the runbook manually from a machine with access to the portal or via PowerShell using the run.ps1 file from this repository.\nSee the add-on README for full air-gapped deployment instructions."
                                    }
                                },
                                {
                                    "name": "runbookContentUri",
                                    "type": "Microsoft.Common.TextBox",
                                    "label": "Runbook Content URI",
                                    "defaultValue": "https://raw.githubusercontent.com/Azure/FederalAVD/main/deployments/add-ons/storageQuotaManager/runbook/run.ps1",
                                    "toolTip": "URI of the runbook PS1 file fetched by Azure at deployment time. Clear this field for air-gapped environments and publish the runbook manually after deployment.",
                                    "constraints": {
                                        "required": false,
                                        "validations": [
                                            {
                                                "regex": "^$|^https?://.+\\.ps1$",
                                                "message": "Must be a valid HTTPS URI ending in .ps1, or clear entirely for air-gapped deployments."
                                            }
                                        ]
                                    }
                                }
                            ]
                        },
                        {
                            "name": "scheduleSection",
                            "type": "Microsoft.Common.Section",
                            "label": "Job Schedule",
                            "elements": [
                                {
                                    "name": "scheduleWarning",
                                    "type": "Microsoft.Common.InfoBox",
                                    "options": {
                                        "style": "Warning",
                                        "text": "REDEPLOYMENT NOTICE\n\nAzure Automation caches the runbook-to-schedule link by automation account name. This cache persists even after deleting the automation account and recreating it with the same name. If you redeploy without unchecking 'Create Job Schedule Link' below, ARM will fail with: A jobSchedule with same id already exists (Conflict).\n\nOn first deployment: leave 'Create Job Schedule Link' checked.\n\nOn every redeployment: UNCHECK 'Create Job Schedule Link'. The runbook will continue running on its existing schedule."
                                    }
                                },
                                {
                                    "name": "createJobSchedule",
                                    "type": "Microsoft.Common.CheckBox",
                                    "label": "Create Job Schedule Link",
                                    "defaultValue": true,
                                    "toolTip": "Check on first deployment to link the runbook to its schedule. UNCHECK on every redeployment to avoid the 'jobSchedule already exists' conflict caused by Azure Automation's backend name-based caching."
                                }
                            ]
                        }
                    ]
                },
                {
                    "name": "tags",
                    "label": "Tags",
                    "elements": [
                        {
                            "name": "tags",
                            "type": "Microsoft.Common.TagsByResource",
                            "resources": [
                                "Microsoft.Automation/automationAccounts"
                            ]
                        }
                    ]
                }
            ]
        },
        "outputs": {
            "parameters": {
                "automationAccountNameOverride": "[if(steps('advanced').namingSection.enableNameOverride, steps('advanced').namingSection.automationAccountNameOverride, '')]",
                "identifier": "[steps('storage').identifier]",
                "storageResourceGroupId": "[steps('storage').storageResourceGroup]",
                "scheduleFrequencyMinutes": "[steps('storage').scheduleFrequencyMinutes]",
                "logAnalyticsWorkspaceResourceId": "[if(steps('monitoring').enableMonitoring, steps('monitoring').logAnalyticsWorkspace.id, '')]",
                "runbookContentUri": "[steps('advanced').runbookSection.runbookContentUri]",
                "createJobSchedule": "[steps('advanced').scheduleSection.createJobSchedule]",
                "tags": "[steps('tags').tags]"
            },
            "kind": "ResourceGroup",
            "location": "[steps('basics').resourceScope.location.name]",
            "resourceGroupId": "[steps('basics').resourceScope.resourceGroup.id]"
        }
    }
}
