{
    "$schema": "https://schema.management.azure.com/schemas/2021-09-09/uiFormDefinition.schema.json",
    "view": {
        "kind": "Form",
        "properties": {
            "title": "FSLogix Storage Quota Manager",
            "steps": [
                {
                    "name": "basics",
                    "label": "Deployment Basics",
                    "elements": [
                        {
                            "name": "infoBox1",
                            "type": "Microsoft.Common.TextBlock",
                            "visible": true,
                            "options": {
                                "text": "Deploys an Azure Automation Account with a PowerShell runbook that automatically increases FSLogix Azure Files Premium share quotas before they fill up. The runbook runs on a configurable schedule and uses a system-assigned managed identity for authentication."
                            }
                        },
                        {
                            "name": "resourceScope",
                            "type": "Microsoft.Common.ResourceScope",
                            "subscription": {
                                "resourceProviders": [
                                    "Microsoft.Automation/automationAccounts"
                                ]
                            },
                            "resourceGroup": {
                                "allowExisting": true
                            },
                            "location": {
                                "label": "Region",
                                "toolTip": "Select the Azure region for the Automation Account.",
                                "resourceTypes": [
                                    "Microsoft.Automation/automationAccounts"
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "storage",
                    "label": "Storage Settings",
                    "elements": [
                        {
                            "name": "infoStorage",
                            "type": "Microsoft.Common.TextBlock",
                            "visible": true,
                            "options": {
                                "text": "Select the resource group that contains your FSLogix Azure Files Premium storage accounts. The Automation Account managed identity will be granted Storage Account Contributor on this resource group."
                            }
                        },
                        {
                            "name": "storageResourceGroup",
                            "type": "Microsoft.Solutions.ResourceSelector",
                            "label": "Storage Resource Group",
                            "resourceType": "Microsoft.Resources/resourceGroups",
                            "options": {
                                "filter": {
                                    "subscription": "onBasics"
                                }
                            }
                        },
                        {
                            "name": "scheduleFrequencyMinutes",
                            "type": "Microsoft.Common.DropDown",
                            "label": "Check Frequency",
                            "defaultValue": "Every 15 minutes",
                            "toolTip": "How often the runbook checks storage account share usage and expands quotas as needed.",
                            "constraints": {
                                "required": true,
                                "allowedValues": [
                                    {
                                        "label": "Every 15 minutes",
                                        "value": 15
                                    },
                                    {
                                        "label": "Every 30 minutes",
                                        "value": 30
                                    },
                                    {
                                        "label": "Every 60 minutes",
                                        "value": 60
                                    }
                                ]
                            }
                        }
                    ]
                },
                {
                    "name": "monitoring",
                    "label": "Monitoring",
                    "elements": [
                        {
                            "name": "enableMonitoring",
                            "type": "Microsoft.Common.CheckBox",
                            "label": "Enable Monitoring",
                            "defaultValue": true,
                            "toolTip": "Send Automation Account job logs and metrics to a Log Analytics Workspace."
                        },
                        {
                            "name": "logAnalyticsWorkspace",
                            "type": "Microsoft.Solutions.ResourceSelector",
                            "label": "Log Analytics Workspace",
                            "resourceType": "Microsoft.OperationalInsights/workspaces",
                            "visible": "[steps('monitoring').enableMonitoring]"
                        }
                    ]
                },
                {
                    "name": "advanced",
                    "label": "Advanced",
                    "elements": [
                        {
                            "name": "infoBox1",
                            "type": "Microsoft.Common.InfoBox",
                            "options": {
                                "style": "Info",
                                "text": "Use this page to override resource names or provide a custom runbook URI. Leave all fields blank to use automatically derived names and the default public GitHub URI."
                            }
                        },
                        {
                            "name": "namingSection",
                            "type": "Microsoft.Common.Section",
                            "label": "Resource Name Overrides",
                            "elements": [
                                {
                                    "name": "namingInfo",
                                    "type": "Microsoft.Common.InfoBox",
                                    "options": {
                                        "style": "Info",
                                        "text": "Leave blank to use a name automatically derived from the storage resource group."
                                    }
                                },
                                {
                                    "name": "automationAccountNameOverride",
                                    "type": "Microsoft.Common.TextBox",
                                    "label": "Automation Account Name",
                                    "placeholder": "aa-sqm-prod-eus2",
                                    "toolTip": "Optional. Explicit name for the Automation Account. Must be 6-128 characters, alphanumeric and hyphens.",
                                    "constraints": {
                                        "required": false,
                                        "validations": [
                                            {
                                                "regex": "^$|^[a-zA-Z0-9-]{6,128}$",
                                                "message": "Automation Account name must be 6-128 characters, alphanumeric and hyphens only."
                                            }
                                        ]
                                    }
                                }
                            ]
                        },
                        {
                            "name": "runbookSection",
                            "type": "Microsoft.Common.Section",
                            "label": "Runbook Content",
                            "elements": [
                                {
                                    "name": "runbookInfo",
                                    "type": "Microsoft.Common.InfoBox",
                                    "options": {
                                        "style": "Info",
                                        "text": "The runbook is downloaded from the URI below when the template is deployed. The field is pre-populated with the public FederalAVD GitHub repository.\n\nAIR-GAPPED / INTERNET-RESTRICTED ENVIRONMENTS\n\nAzure Automation fetches this URI from Azure infrastructure, not from inside your network. If your environment cannot reach the public internet:\n1. Clear this field entirely (leave it blank).\n2. Deploy the template normally. The runbook resource will be created in an unpublished (New) state - the schedule is configured but no jobs will run.\n3. After deployment, publish the runbook manually:\n   - Portal: Automation Account > Runbooks > Import a runbook > browse to runbook/run.ps1\n   - PowerShell: Import-AzAutomationRunbook then Publish-AzAutomationRunbook\nSee the add-on README for full instructions."
                                    }
                                },
                                {
                                    "name": "runbookContentUri",
                                    "type": "Microsoft.Common.TextBox",
                                    "label": "Runbook Content URI",
                                    "defaultValue": "https://raw.githubusercontent.com/Azure/FederalAVD/main/deployments/add-ons/storageQuotaManager/runbook/run.ps1",
                                    "toolTip": "URI of the runbook PS1 file fetched by Azure at deployment time. Clear this field for air-gapped environments and publish the runbook manually after deployment.",
                                    "constraints": {
                                        "required": false,
                                        "validations": [
                                            {
                                                "regex": "^$|^https?://.+\\.ps1$",
                                                "message": "Must be a valid HTTPS URI ending in .ps1, or clear entirely for air-gapped deployments."
                                            }
                                        ]
                                    }
                                }
                            ]
                        },
                        {
                            "name": "scheduleSection",
                            "type": "Microsoft.Common.Section",
                            "label": "Job Schedule",
                            "elements": [
                                {
                                    "name": "scheduleWarning",
                                    "type": "Microsoft.Common.InfoBox",
                                    "options": {
                                        "style": "Warning",
                                        "text": "REDEPLOYMENT NOTICE\n\nAzure Automation caches the runbook-to-schedule link by automation account name. This cache persists even after deleting the automation account and recreating it with the same name. If you redeploy without unchecking 'Create Job Schedule Link' below, ARM will fail with: A jobSchedule with same id already exists (Conflict).\n\nOn first deployment: leave 'Create Job Schedule Link' checked.\n\nOn every redeployment: UNCHECK 'Create Job Schedule Link'. The runbook will continue running on its existing schedule."
                                    }
                                },
                                {
                                    "name": "createJobSchedule",
                                    "type": "Microsoft.Common.CheckBox",
                                    "label": "Create Job Schedule Link",
                                    "defaultValue": true,
                                    "toolTip": "Check on first deployment to link the runbook to its schedule. UNCHECK on every redeployment to avoid the 'jobSchedule already exists' conflict caused by Azure Automation's backend name-based caching."
                                }
                            ]
                        }
                    ]
                },
                {
                    "name": "tags",
                    "label": "Tags",
                    "elements": [
                        {
                            "name": "tags",
                            "type": "Microsoft.Common.TagsByResource",
                            "resources": [
                                "Microsoft.Automation/automationAccounts"
                            ]
                        }
                    ]
                }
            ]
        },
        "outputs": {
            "parameters": {
                "automationAccountNameOverride": "[steps('advanced').namingSection.automationAccountNameOverride]",
                "storageResourceGroupId": "[steps('storage').storageResourceGroup.id]",
                "scheduleFrequencyMinutes": "[steps('storage').scheduleFrequencyMinutes]",
                "logAnalyticsWorkspaceResourceId": "[if(steps('monitoring').enableMonitoring, steps('monitoring').logAnalyticsWorkspace.id, '')]",
                "runbookContentUri": "[steps('advanced').runbookSection.runbookContentUri]",
                "createJobSchedule": "[steps('advanced').scheduleSection.createJobSchedule]",
                "tags": "[steps('tags').tags]"
            },
            "kind": "ResourceGroup",
            "location": "[steps('basics').resourceScope.location.name]",
            "resourceGroupId": "[steps('basics').resourceScope.resourceGroup.id]"
        }
    }
}