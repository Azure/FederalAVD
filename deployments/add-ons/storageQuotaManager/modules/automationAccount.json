      "apiVersion": "2023-11-01",
      "name": "[format('{0}/{1}', parameters('automationAccountName'), 'ResourceManagerUri')]",
      "properties": {
        "value": "[format('\"{0}\"', parameters('resourceManagerUri'))]",
        "isEncrypted": false,
        "description": "Azure Resource Manager endpoint URI for this cloud."
      },
