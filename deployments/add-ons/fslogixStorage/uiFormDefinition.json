{
  "$schema": "https://schema.management.azure.com/schemas/2021-09-09/uiFormDefinition.schema.json",
  "view": {
    "kind": "Form",
    "properties": {
      "title": "FSLogix Storage",
      "steps": [
        {
          "name": "scope",
          "label": "Deployment Scope",
          "elements": [
            {
              "name": "intro",
              "type": "Microsoft.Common.InfoBox",
              "options": {
                "style": "Info",
                "text": "Deploy standalone FSLogix storage before creating automated session hosts. An existing deployment VM and its managed identity are required for domain registration, Entra Kerberos application updates, and NTFS initialization."
              }
            },
            {
              "name": "subscriptionsApi",
              "type": "Microsoft.Solutions.ArmApiControl",
              "request": { "method": "GET", "path": "/subscriptions?api-version=2022-12-01" }
            },
            {
              "name": "subscription",
              "type": "Microsoft.Common.DropDown",
              "label": "Subscription",
              "constraints": {
                "allowedValues": "[map(steps('scope').subscriptionsApi.value, (sub) => parse(concat('{\"label\":\"', sub.displayName, '\",\"value\":{\"id\":\"', sub.id, '\",\"subscriptionId\":\"', sub.subscriptionId, '\"}}')))]",
                "required": true
              }
            },
            {
              "name": "locationsApi",
              "type": "Microsoft.Solutions.ArmApiControl",
              "condition": "[not(empty(steps('scope').subscription))]",
              "request": { "method": "GET", "path": "[concat(steps('scope').subscription.id, '/locations?api-version=2022-12-01')]" }
            },
            {
              "name": "location",
              "type": "Microsoft.Common.DropDown",
              "label": "Region",
              "constraints": {
                "allowedValues": "[map(steps('scope').locationsApi.value, (loc) => parse(concat('{\"label\":\"', loc.displayName, '\",\"value\":\"', loc.name, '\"}')))]",
                "required": true
              }
            },
            {
              "name": "resourceGroupsApi",
              "type": "Microsoft.Solutions.ArmApiControl",
              "condition": "[not(empty(steps('scope').subscription))]",
              "request": { "method": "GET", "path": "[concat(steps('scope').subscription.id, '/resourcegroups?api-version=2024-03-01')]" }
            },
            {
              "name": "storageResourceGroup",
              "type": "Microsoft.Common.DropDown",
              "label": "Storage Resource Group",
              "constraints": {
                "allowedValues": "[map(steps('scope').resourceGroupsApi.value, (rg) => parse(concat('{\"label\":\"', rg.name, '\",\"description\":\"Location: ', rg.location, '\",\"value\":\"', rg.name, '\"}')))]",
                "required": true
              }
            },
            {
              "name": "deploymentResourceGroup",
              "type": "Microsoft.Common.DropDown",
              "label": "Deployment VM Resource Group",
              "constraints": {
                "allowedValues": "[map(steps('scope').resourceGroupsApi.value, (rg) => parse(concat('{\"label\":\"', rg.name, '\",\"description\":\"Location: ', rg.location, '\",\"value\":{\"id\":\"', rg.id, '\",\"name\":\"', rg.name, '\"}}')))]",
                "required": true
              }
            },
            {
              "name": "virtualMachinesApi",
              "type": "Microsoft.Solutions.ArmApiControl",
              "condition": "[not(empty(steps('scope').deploymentResourceGroup))]",
              "request": { "method": "GET", "path": "[concat(steps('scope').deploymentResourceGroup.id, '/providers/Microsoft.Compute/virtualMachines?api-version=2024-07-01')]" }
            },
            {
              "name": "deploymentVirtualMachine",
              "type": "Microsoft.Common.DropDown",
              "label": "Deployment Virtual Machine",
              "constraints": {
                "allowedValues": "[map(steps('scope').virtualMachinesApi.value, (vm) => parse(concat('{\"label\":\"', vm.name, '\",\"value\":\"', vm.name, '\"}')))]",
                "required": true
              }
            },
            {
              "name": "deploymentIdentityClientId",
              "type": "Microsoft.Common.TextBox",
              "label": "Deployment VM Identity Client ID",
              "toolTip": "Enter the client ID of the user-assigned identity attached to the deployment VM.",
              "constraints": {
                "required": true,
                "regex": "^[0-9a-fA-F-]{36}$",
                "validationMessage": "Enter a managed identity client ID GUID."
              }
            },
            {
              "name": "parentResourceId",
              "type": "Microsoft.Common.TextBox",
              "label": "Cost Management Parent Resource ID",
              "defaultValue": "",
              "constraints": { "required": false }
            }
          ]
        },
        {
          "name": "identity",
          "label": "Identity and Permissions",
          "elements": [
            {
              "name": "identitySolution",
              "type": "Microsoft.Common.DropDown",
              "label": "Identity Solution",
              "defaultValue": "Storage Account Keys",
              "constraints": {
                "required": true,
                "allowedValues": [
                  { "label": "Active Directory Domain Services", "value": "ActiveDirectoryDomainServices" },
                  { "label": "Microsoft Entra Domain Services", "value": "EntraDomainServices" },
                  { "label": "Microsoft Entra Kerberos (hybrid identities)", "value": "EntraKerberos-Hybrid" },
                  { "label": "Microsoft Entra Kerberos (cloud-only identities)", "value": "EntraKerberos-CloudOnly" },
                  { "label": "Storage Account Keys", "value": "EntraId" }
                ]
              }
            },
            {
              "name": "domainName",
              "type": "Microsoft.Common.TextBox",
              "label": "Domain Name",
              "placeholder": "contoso.com",
              "visible": "[or(equals(steps('identity').identitySolution, 'ActiveDirectoryDomainServices'), equals(steps('identity').identitySolution, 'EntraDomainServices'), equals(steps('identity').identitySolution, 'EntraKerberos-Hybrid'), startsWith(steps('storage').storageService, 'AzureNetAppFiles'))]",
              "constraints": { "required": true }
            },
            {
              "name": "organizationalUnitPath",
              "type": "Microsoft.Common.TextBox",
              "label": "Organizational Unit Path",
              "defaultValue": "",
              "visible": "[not(empty(steps('identity').domainName))]",
              "constraints": { "required": false }
            },
            {
              "name": "domainJoinUserPrincipalName",
              "type": "Microsoft.Common.TextBox",
              "label": "Domain Join Account User Principal Name",
              "visible": "[not(empty(steps('identity').domainName))]",
              "constraints": { "required": true }
            },
            {
              "name": "domainJoinUserPassword",
              "type": "Microsoft.Common.PasswordBox",
              "label": { "password": "Domain Join Account Password", "confirmPassword": "Confirm Password" },
              "visible": "[not(empty(steps('identity').domainName))]",
              "constraints": { "required": true },
              "options": { "hideConfirmation": false }
            },
            {
              "name": "appUpdateIdentity",
              "type": "Microsoft.Solutions.ResourceSelector",
              "label": "Entra Kerberos Application Update Identity",
              "resourceType": "Microsoft.ManagedIdentity/userAssignedIdentities",
              "visible": "[contains(steps('identity').identitySolution, 'EntraKerberos')]",
              "constraints": { "required": false },
              "scope": { "subscriptionId": "[steps('scope').subscription.subscriptionId]" }
            },
            {
              "name": "adminGroups",
              "type": "Microsoft.Common.EditableGrid",
              "label": "FSLogix Administrator Groups",
              "ariaLabel": "FSLogix Administrator Groups",
              "constraints": {
                "width": "Full",
                "rows": { "count": { "min": 0, "max": 20 } },
                "columns": [
                  { "id": "name", "header": "Group Name", "width": "1fr", "element": { "type": "Microsoft.Common.TextBox", "constraints": { "required": true } } },
                  { "id": "id", "header": "Microsoft Entra Object ID", "width": "1fr", "element": { "type": "Microsoft.Common.TextBox", "constraints": { "required": true } } }
                ]
              }
            },
            {
              "name": "userGroups",
              "type": "Microsoft.Common.EditableGrid",
              "label": "FSLogix User and Sharding Groups",
              "ariaLabel": "FSLogix User and Sharding Groups",
              "constraints": {
                "width": "Full",
                "rows": { "count": { "min": 0, "max": 20 } },
                "columns": [
                  { "id": "name", "header": "Group Name", "width": "1fr", "element": { "type": "Microsoft.Common.TextBox", "constraints": { "required": true } } },
                  { "id": "id", "header": "Microsoft Entra Object ID", "width": "1fr", "element": { "type": "Microsoft.Common.TextBox", "constraints": { "required": true } } }
                ]
              }
            }
          ]
        },
        {
          "name": "storage",
          "label": "Storage Configuration",
          "elements": [
            {
              "name": "storageService",
              "type": "Microsoft.Common.DropDown",
              "label": "Storage Service and SKU",
              "defaultValue": "Azure Files Standard",
              "constraints": {
                "required": true,
                "allowedValues": [
                  { "label": "Azure Files Premium", "value": "AzureFiles Premium" },
                  { "label": "Azure Files Standard", "value": "AzureFiles Standard" },
                  { "label": "Azure NetApp Files Premium", "value": "AzureNetAppFiles Premium" },
                  { "label": "Azure NetApp Files Standard", "value": "AzureNetAppFiles Standard" }
                ]
              }
            },
            {
              "name": "storageRedundancy",
              "type": "Microsoft.Common.DropDown",
              "label": "Azure Files Redundancy",
              "defaultValue": "Locally Redundant",
              "visible": "[startsWith(steps('storage').storageService, 'AzureFiles')]",
              "constraints": {
                "allowedValues": [
                  { "label": "Locally Redundant", "value": "LocallyRedundant" },
                  { "label": "Zone Redundant", "value": "ZoneRedundant" }
                ]
              }
            },
            {
              "name": "containerType",
              "type": "Microsoft.Common.DropDown",
              "label": "FSLogix Container Type(s)",
              "defaultValue": "Profile Container",
              "constraints": {
                "required": true,
                "allowedValues": [
                  { "label": "Cloud Cache, Profile Container", "value": "CloudCacheProfileContainer" },
                  { "label": "Cloud Cache, Profile and Office Container", "value": "CloudCacheProfileOfficeContainer" },
                  { "label": "Profile Container", "value": "ProfileContainer" },
                  { "label": "Profile and Office Container", "value": "ProfileOfficeContainer" }
                ]
              }
            },
            {
              "name": "profileSizeInMBs",
              "type": "Microsoft.Common.TextBox",
              "label": "Profile Container Size (MB)",
              "defaultValue": "30000",
              "constraints": { "required": true, "regex": "^[1-9][0-9]*$", "validationMessage": "Enter a positive whole number." }
            },
            {
              "name": "shareSizeInGB",
              "type": "Microsoft.Common.TextBox",
              "label": "File Share or Volume Size (GB)",
              "defaultValue": "100",
              "constraints": { "required": true, "regex": "^[1-9][0-9]*$", "validationMessage": "Enter a positive whole number." }
            },
            {
              "name": "shardOptions",
              "type": "Microsoft.Common.OptionsGroup",
              "label": "Sharding Options",
              "defaultValue": "No Sharding",
              "visible": "[startsWith(steps('storage').storageService, 'AzureFiles')]",
              "constraints": {
                "allowedValues": [
                  { "label": "No Sharding", "value": "None" },
                  { "label": "Sharding via Permissions", "value": "ShardPerms" },
                  { "label": "Sharding via Object Specific Settings", "value": "ShardOSS" }
                ]
              }
            },
            {
              "name": "storageAccountNamePrefix",
              "type": "Microsoft.Common.TextBox",
              "label": "Storage Account Name Prefix",
              "defaultValue": "fslogix",
              "visible": "[startsWith(steps('storage').storageService, 'AzureFiles')]",
              "constraints": { "required": true, "regex": "^[a-z0-9]{1,22}$", "validationMessage": "Use 1-22 lowercase letters or numbers." }
            },
            {
              "name": "storageIndex",
              "type": "Microsoft.Common.TextBox",
              "label": "Starting Storage Index",
              "defaultValue": "1",
              "visible": "[startsWith(steps('storage').storageService, 'AzureFiles')]",
              "constraints": { "required": true, "regex": "^([0-9]|[1-9][0-9])$", "validationMessage": "Enter a number from 0 through 99." }
            },
            {
              "name": "deploymentSuffix",
              "type": "Microsoft.Common.TextBox",
              "label": "Deployment Suffix",
              "defaultValue": "fslogix",
              "constraints": { "required": true, "regex": "^[A-Za-z0-9-]{1,32}$", "validationMessage": "Use 1-32 letters, numbers, or dashes." }
            },
            {
              "name": "softDeleteRetentionDays",
              "type": "Microsoft.Common.TextBox",
              "label": "Deleted Share Retention (days)",
              "defaultValue": "14",
              "visible": "[startsWith(steps('storage').storageService, 'AzureFiles')]",
              "constraints": { "required": true, "regex": "^([1-9]|[1-9][0-9]|[12][0-9]{2}|3[0-5][0-9]|36[0-5])$", "validationMessage": "Enter 1-365." }
            },
            {
              "name": "kerberosEncryptionType",
              "type": "Microsoft.Common.DropDown",
              "label": "Kerberos Encryption Type",
              "defaultValue": "AES256",
              "visible": "[and(startsWith(steps('storage').storageService, 'AzureFiles'), not(equals(steps('identity').identitySolution, 'EntraId')))]",
              "constraints": { "allowedValues": [ { "label": "AES256", "value": "AES256" }, { "label": "RC4", "value": "RC4" } ] }
            }
          ]
        },
        {
          "name": "networking",
          "label": "Networking",
          "elements": [
            {
              "name": "privateEndpoint",
              "type": "Microsoft.Common.CheckBox",
              "label": "Deploy Azure Files private endpoints",
              "defaultValue": true,
              "visible": "[startsWith(steps('storage').storageService, 'AzureFiles')]"
            },
            {
              "name": "privateEndpointSubnet",
              "type": "Microsoft.Solutions.ResourceSelector",
              "label": "Private Endpoint Subnet",
              "resourceType": "Microsoft.Network/virtualNetworks/subnets",
              "visible": "[and(startsWith(steps('storage').storageService, 'AzureFiles'), steps('networking').privateEndpoint)]",
              "constraints": { "required": true },
              "scope": { "subscriptionId": "[steps('scope').subscription.subscriptionId]" }
            },
            {
              "name": "azureFilePrivateDnsZone",
              "type": "Microsoft.Solutions.ResourceSelector",
              "label": "Azure Files Private DNS Zone",
              "resourceType": "Microsoft.Network/privateDnsZones",
              "visible": "[and(startsWith(steps('storage').storageService, 'AzureFiles'), steps('networking').privateEndpoint)]",
              "constraints": { "required": false },
              "scope": { "subscriptionId": "[steps('scope').subscription.subscriptionId]" }
            },
            {
              "name": "privateEndpointNameConvention",
              "type": "Microsoft.Common.TextBox",
              "label": "Private Endpoint Naming Convention",
              "defaultValue": "pe-RESOURCE-SUBRESOURCE-VNETID",
              "visible": "[and(startsWith(steps('storage').storageService, 'AzureFiles'), steps('networking').privateEndpoint)]",
              "constraints": { "required": true }
            },
            {
              "name": "privateEndpointNicNameConvention",
              "type": "Microsoft.Common.TextBox",
              "label": "Private Endpoint NIC Naming Convention",
              "defaultValue": "nic-RESOURCE-SUBRESOURCE-VNETID",
              "visible": "[and(startsWith(steps('storage').storageService, 'AzureFiles'), steps('networking').privateEndpoint)]",
              "constraints": { "required": true }
            },
            {
              "name": "permittedIPs",
              "type": "Microsoft.Common.EditableGrid",
              "label": "Permitted IP Addresses and CIDR Blocks",
              "ariaLabel": "Permitted IP Addresses and CIDR Blocks",
              "visible": "[startsWith(steps('storage').storageService, 'AzureFiles')]",
              "constraints": {
                "width": "Full",
                "rows": { "count": { "min": 0, "max": 50 } },
                "columns": [ { "id": "value", "header": "IP Address or CIDR", "width": "1fr", "element": { "type": "Microsoft.Common.TextBox", "constraints": { "required": true } } } ]
              }
            }
          ]
        },
        {
          "name": "encryptionOperations",
          "label": "Encryption and Operations",
          "elements": [
            {
              "name": "keyManagementStorage",
              "type": "Microsoft.Common.DropDown",
              "label": "Storage Encryption Key Management",
              "defaultValue": "Platform Managed",
              "visible": "[startsWith(steps('storage').storageService, 'AzureFiles')]",
              "constraints": {
                "allowedValues": [
                  { "label": "Platform Managed", "value": "PlatformManaged" },
                  { "label": "Customer Managed", "value": "CustomerManaged" },
                  { "label": "Customer Managed HSM", "value": "CustomerManagedHSM" }
                ]
              }
            },
            {
              "name": "encryptionKeyVaultUri",
              "type": "Microsoft.Common.TextBox",
              "label": "Encryption Key Vault URI",
              "visible": "[contains(steps('encryptionOperations').keyManagementStorage, 'CustomerManaged')]",
              "constraints": { "required": true }
            },
            {
              "name": "encryptionKeyNameConvention",
              "type": "Microsoft.Common.TextBox",
              "label": "Encryption Key Naming Convention",
              "defaultValue": "key-fsl-##",
              "visible": "[contains(steps('encryptionOperations').keyManagementStorage, 'CustomerManaged')]",
              "constraints": { "required": true, "regex": "^.*##.*$", "validationMessage": "Include the ## storage index token." }
            },
            {
              "name": "encryptionIdentity",
              "type": "Microsoft.Solutions.ResourceSelector",
              "label": "Encryption User Assigned Identity",
              "resourceType": "Microsoft.ManagedIdentity/userAssignedIdentities",
              "visible": "[contains(steps('encryptionOperations').keyManagementStorage, 'CustomerManaged')]",
              "constraints": { "required": true },
              "scope": { "subscriptionId": "[steps('scope').subscription.subscriptionId]" }
            },
            {
              "name": "logAnalyticsWorkspace",
              "type": "Microsoft.Solutions.ResourceSelector",
              "label": "Log Analytics Workspace",
              "resourceType": "Microsoft.OperationalInsights/workspaces",
              "constraints": { "required": false },
              "scope": { "subscriptionId": "[steps('scope').subscription.subscriptionId]" }
            },
            {
              "name": "recoveryServicesVault",
              "type": "Microsoft.Solutions.ResourceSelector",
              "label": "Recovery Services Vault",
              "resourceType": "Microsoft.RecoveryServices/vaults",
              "visible": "[startsWith(steps('storage').storageService, 'AzureFiles')]",
              "constraints": { "required": false },
              "scope": { "subscriptionId": "[steps('scope').subscription.subscriptionId]" }
            },
            {
              "name": "fileSharePolicyName",
              "type": "Microsoft.Common.TextBox",
              "label": "Azure Files Backup Policy Name",
              "defaultValue": "filesharepolicy",
              "visible": "[not(empty(steps('encryptionOperations').recoveryServicesVault))]",
              "constraints": { "required": true }
            }
          ]
        },
        {
          "name": "netAppRemote",
          "label": "Azure NetApp Files and Remote Storage",
          "elements": [
            {
              "name": "existingSharedActiveDirectoryConnection",
              "type": "Microsoft.Common.CheckBox",
              "label": "Azure NetApp account already has the required Active Directory connection",
              "defaultValue": false,
              "visible": "[startsWith(steps('storage').storageService, 'AzureNetAppFiles')]"
            },
            {
              "name": "netAppAccountName",
              "type": "Microsoft.Common.TextBox",
              "label": "Azure NetApp Files Account Name",
              "defaultValue": "anf-fslogix",
              "visible": "[startsWith(steps('storage').storageService, 'AzureNetAppFiles')]",
              "constraints": { "required": true }
            },
            {
              "name": "netAppCapacityPoolName",
              "type": "Microsoft.Common.TextBox",
              "label": "Azure NetApp Files Capacity Pool Name",
              "defaultValue": "pool-fslogix",
              "visible": "[startsWith(steps('storage').storageService, 'AzureNetAppFiles')]",
              "constraints": { "required": true }
            },
            {
              "name": "netAppVolumesSubnet",
              "type": "Microsoft.Solutions.ResourceSelector",
              "label": "Azure NetApp Files Delegated Subnet",
              "resourceType": "Microsoft.Network/virtualNetworks/subnets",
              "visible": "[startsWith(steps('storage').storageService, 'AzureNetAppFiles')]",
              "constraints": { "required": true },
              "scope": { "subscriptionId": "[steps('scope').subscription.subscriptionId]" }
            },
            {
              "name": "smbServerLocation",
              "type": "Microsoft.Common.TextBox",
              "label": "SMB Server Location Token",
              "defaultValue": "[steps('scope').location]",
              "visible": "[startsWith(steps('storage').storageService, 'AzureNetAppFiles')]",
              "constraints": { "required": true }
            },
            {
              "name": "remoteStorageAccountResourceIds",
              "type": "Microsoft.Common.EditableGrid",
              "label": "Existing Remote Azure Files Storage Account Resource IDs",
              "ariaLabel": "Existing Remote Azure Files Storage Account Resource IDs",
              "visible": "[and(startsWith(steps('storage').storageService, 'AzureFiles'), contains(steps('storage').containerType, 'CloudCache'))]",
              "constraints": {
                "width": "Full",
                "rows": { "count": { "min": 0, "max": 20 } },
                "columns": [ { "id": "resourceId", "header": "Resource ID", "width": "1fr", "element": { "type": "Microsoft.Common.TextBox", "constraints": { "required": true } } } ]
              }
            },
            {
              "name": "remoteNetAppServerFqdns",
              "type": "Microsoft.Common.EditableGrid",
              "label": "Existing Remote Azure NetApp Files SMB Server FQDNs",
              "ariaLabel": "Existing Remote Azure NetApp Files SMB Server FQDNs",
              "visible": "[and(startsWith(steps('storage').storageService, 'AzureNetAppFiles'), contains(steps('storage').containerType, 'CloudCache'))]",
              "constraints": {
                "width": "Full",
                "rows": { "count": { "min": 0, "max": 20 } },
                "columns": [ { "id": "fqdn", "header": "SMB Server FQDN", "width": "1fr", "element": { "type": "Microsoft.Common.TextBox", "constraints": { "required": true } } } ]
              }
            }
          ]
        },
        {
          "name": "tags",
          "label": "Tags",
          "elements": [
            {
              "name": "tags",
              "type": "Microsoft.Common.TagsByResource",
              "resources": [
                "Microsoft.Storage/storageAccounts",
                "Microsoft.NetApp/netAppAccounts",
                "Microsoft.NetApp/netAppAccounts/capacityPools",
                "Microsoft.NetApp/netAppAccounts/capacityPools/volumes",
                "Microsoft.Network/privateEndpoints"
              ]
            }
          ]
        }
      ]
    },
    "outputs": {
      "parameters": {
        "location": "[steps('scope').location]",
        "storageResourceGroupName": "[steps('scope').storageResourceGroup]",
        "deploymentResourceGroupName": "[steps('scope').deploymentResourceGroup.name]",
        "deploymentVirtualMachineName": "[steps('scope').deploymentVirtualMachine]",
        "deploymentUserAssignedIdentityClientId": "[steps('scope').deploymentIdentityClientId]",
        "identitySolution": "[steps('identity').identitySolution]",
        "domainJoinUserPrincipalName": "[if(empty(steps('identity').domainName), '', steps('identity').domainJoinUserPrincipalName)]",
        "domainJoinUserPassword": "[if(empty(steps('identity').domainName), '', steps('identity').domainJoinUserPassword.password)]",
        "domainName": "[coalesce(steps('identity').domainName, '')]",
        "organizationalUnitPath": "[if(empty(steps('identity').domainName), '', steps('identity').organizationalUnitPath)]",
        "appUpdateUserAssignedIdentityResourceId": "[if(contains(steps('identity').identitySolution, 'EntraKerberos'), steps('identity').appUpdateIdentity.id, '')]",
        "fslogixStorageService": "[steps('storage').storageService]",
        "fslogixStorageRedundancy": "[if(startsWith(steps('storage').storageService, 'AzureFiles'), steps('storage').storageRedundancy, 'LocallyRedundant')]",
        "fslogixContainerType": "[steps('storage').containerType]",
        "profileSizeInMBs": "[int(steps('storage').profileSizeInMBs)]",
        "shareSizeInGB": "[int(steps('storage').shareSizeInGB)]",
        "fslogixShardOptions": "[if(startsWith(steps('storage').storageService, 'AzureFiles'), steps('storage').shardOptions, 'None')]",
        "fslogixAdminGroups": "[steps('identity').adminGroups]",
        "fslogixUserGroups": "[steps('identity').userGroups]",
        "storageAccountNamePrefix": "[if(startsWith(steps('storage').storageService, 'AzureFiles'), steps('storage').storageAccountNamePrefix, 'fslogix')]",
        "storageIndex": "[if(startsWith(steps('storage').storageService, 'AzureFiles'), int(steps('storage').storageIndex), 1)]",
        "deploymentSuffix": "[steps('storage').deploymentSuffix]",
        "parentResourceId": "[steps('scope').parentResourceId]",
        "privateEndpoint": "[and(startsWith(steps('storage').storageService, 'AzureFiles'), steps('networking').privateEndpoint)]",
        "privateEndpointSubnetResourceId": "[if(and(startsWith(steps('storage').storageService, 'AzureFiles'), steps('networking').privateEndpoint), steps('networking').privateEndpointSubnet.id, '')]",
        "azureFilePrivateDnsZoneResourceId": "[if(and(startsWith(steps('storage').storageService, 'AzureFiles'), steps('networking').privateEndpoint, not(empty(steps('networking').azureFilePrivateDnsZone))), steps('networking').azureFilePrivateDnsZone.id, '')]",
        "privateEndpointNameConvention": "[steps('networking').privateEndpointNameConvention]",
        "privateEndpointNicNameConvention": "[steps('networking').privateEndpointNicNameConvention]",
        "permittedIPs": "[map(steps('networking').permittedIPs, (item) => item.value)]",
        "logAnalyticsWorkspaceResourceId": "[if(empty(steps('encryptionOperations').logAnalyticsWorkspace), '', steps('encryptionOperations').logAnalyticsWorkspace.id)]",
        "keyManagementStorage": "[if(startsWith(steps('storage').storageService, 'AzureFiles'), steps('encryptionOperations').keyManagementStorage, 'PlatformManaged')]",
        "encryptionKeyVaultUri": "[if(contains(steps('encryptionOperations').keyManagementStorage, 'CustomerManaged'), steps('encryptionOperations').encryptionKeyVaultUri, '')]",
        "fslogixEncryptionKeyNameConvention": "[steps('encryptionOperations').encryptionKeyNameConvention]",
        "encryptionUserAssignedIdentityResourceId": "[if(contains(steps('encryptionOperations').keyManagementStorage, 'CustomerManaged'), steps('encryptionOperations').encryptionIdentity.id, '')]",
        "softDeleteRetentionDays": "[int(steps('storage').softDeleteRetentionDays)]",
        "kerberosEncryptionType": "[if(and(startsWith(steps('storage').storageService, 'AzureFiles'), not(equals(steps('identity').identitySolution, 'EntraId'))), steps('storage').kerberosEncryptionType, 'AES256')]",
        "recoveryServicesVaultResourceId": "[if(empty(steps('encryptionOperations').recoveryServicesVault), '', steps('encryptionOperations').recoveryServicesVault.id)]",
        "fileSharePolicyName": "[steps('encryptionOperations').fileSharePolicyName]",
        "existingSharedActiveDirectoryConnection": "[if(startsWith(steps('storage').storageService, 'AzureNetAppFiles'), steps('netAppRemote').existingSharedActiveDirectoryConnection, false)]",
        "netAppAccountName": "[steps('netAppRemote').netAppAccountName]",
        "netAppCapacityPoolName": "[steps('netAppRemote').netAppCapacityPoolName]",
        "netAppVolumesSubnetResourceId": "[if(startsWith(steps('storage').storageService, 'AzureNetAppFiles'), steps('netAppRemote').netAppVolumesSubnet.id, '')]",
        "smbServerLocation": "[if(startsWith(steps('storage').storageService, 'AzureNetAppFiles'), steps('netAppRemote').smbServerLocation, steps('scope').location)]",
        "remoteStorageAccountResourceIds": "[if(and(startsWith(steps('storage').storageService, 'AzureFiles'), contains(steps('storage').containerType, 'CloudCache')), map(steps('netAppRemote').remoteStorageAccountResourceIds, (item) => item.resourceId), parse('[]'))]",
        "remoteNetAppServerFqdns": "[if(and(startsWith(steps('storage').storageService, 'AzureNetAppFiles'), contains(steps('storage').containerType, 'CloudCache')), map(steps('netAppRemote').remoteNetAppServerFqdns, (item) => item.fqdn), parse('[]'))]",
        "tags": "[steps('tags').tags]"
      },
      "location": "[steps('scope').location]"
    }
  }
}