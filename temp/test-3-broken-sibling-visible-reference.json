{
  "$schema": "https://schema.management.azure.com/schemas/2021-09-09/uiFormDefinition.schema.json",
  "view": {
    "kind": "Form",
    "properties": {
      "title": "Test 3 - Advanced: Infrastructure Naming (checkbox INSIDE section - BROKEN PATTERN)",
      "steps": [
        {
          "name": "basics",
          "label": "Basics",
          "elements": [
            {
              "name": "subscription",
              "type": "Microsoft.Common.SubscriptionSelector",
              "label": "Subscription"
            },
            {
              "name": "locationsApi",
              "type": "Microsoft.Solutions.ArmApiControl",
              "condition": "[not(empty(steps('basics').subscription.id))]",
              "request": {
                "method": "GET",
                "path": "[concat(steps('basics').subscription.id, '/locations?api-version=2022-12-01')]",
                "transforms": {
                  "list": "sort_by(value, &displayName)[?name!='global' && !contains(displayName, '(Stage)')] | [*].{label: displayName, value: { displayName: displayName, name: name }}"
                }
              }
            },
            {
              "name": "location",
              "type": "Microsoft.Common.DropDown",
              "label": "Region",
              "filter": true,
              "allowedValues": "[steps('basics').locationsApi.transformed.list]"
            },
            {
              "name": "simulatedTagPresent",
              "type": "Microsoft.Common.CheckBox",
              "label": "Simulate: hpNamingConvention tag IS present",
              "defaultValue": true
            }
          ]
        },
        {
          "name": "advanced",
          "label": "Advanced",
          "elements": [
            {
              "name": "infrastructureNaming",
              "type": "Microsoft.Common.Section",
              "label": "Infrastructure Naming",
              "visible": true,
              "elements": [
                {
                  "name": "enableCustomAbbreviations",
                  "type": "Microsoft.Common.CheckBox",
                  "label": "Customize resource type abbreviations",
                  "visible": "[steps('basics').simulatedTagPresent]",
                  "defaultValue": false,
                  "toolTip": "Checkbox INSIDE the section. Other elements in THIS section reference it via sibling path."
                },
                {
                  "name": "functionApps",
                  "type": "Microsoft.Common.TextBox",
                  "label": "Function Apps abbreviation",
                  "visible": "[and(steps('basics').simulatedTagPresent, steps('advanced').infrastructureNaming.enableCustomAbbreviations)]",
                  "placeholder": "fa",
                  "defaultValue": "fa",
                  "constraints": { "required": false, "regex": "^[a-z0-9-]{0,10}$", "validationMessage": "max 10 chars" }
                }
              ]
            }
          ]
        }
      ]
    },
    "outputs": {
      "parameters": {
        "testString": "[steps('basics').location.name]",
        "testBool": "[steps('advanced').infrastructureNaming.enableCustomAbbreviations]",
        "testObject": {}
      },
      "kind": "Subscription",
      "location": "[steps('basics').location.name]",
      "subscriptionId": "[steps('basics').subscription.subscriptionId]"
    }
  }
}
