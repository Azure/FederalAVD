{
    // Minimal Secrets Key Vault prerequisite example for an automated host pool.
    // Supply the VM administrator username and password as secure deployment parameters.
    "$schema": "https://schema.management.azure.com/schemas/2015-01-01/deploymentParameters.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "location": {
            "value": "eastus"
        },
        "deploySecretsKeyVault": {
            "value": true
        },
        "secretsKeyVaultEnableSoftDelete": {
            "value": true
        },
        "secretsKeyVaultEnablePurgeProtection": {
            "value": false
        },
        "secretsKeyVaultRetentionInDays": {
            "value": 7
        },
        "deployEncryptionKeyVault": {
            "value": false
        },
        "paasNetworking": {
            "value": {
                "privateEndpoint": true,
                "publicNetworkAccess": "Disabled",
                // Existing source subnets need Microsoft.KeyVault; select EnabledWithRestrictions to enforce them.
                "keyVault": { "permittedIPs": [], "serviceEndpointSubnetResourceIds": [] }
            }
        },
        "privateEndpointSubnetResourceIds": {
            "value": {
                "sharedResources": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-network/providers/Microsoft.Network/virtualNetworks/vnet-avd/subnets/private-endpoints"
            }
        },
        "privateDnsZoneResourceIds": {
            "value": {
                "vault": "/subscriptions/00000000-0000-0000-0000-000000000000/resourceGroups/rg-network/providers/Microsoft.Network/privateDnsZones/privatelink.vaultcore.azure.net"
            }
        },
        "deployMonitoring": {
            "value": false
        },
        "deployFSLogixBackupVault": {
            "value": false
        }
    }
}