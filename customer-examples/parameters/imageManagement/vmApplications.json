{
  "applications": [
    {
      "name": "Microsoft-AzCLI",
      "version": "1.0.0",
      "packageBlob": "Microsoft-AzCLI.zip",
      "packageFileName": "Microsoft-AzCLI.zip",
      "supportedOSType": "Windows",
      "description": "Azure CLI packaged from the FederalAVD Microsoft-AzCLI customer example.",
      "install": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command \"Expand-Archive -LiteralPath '.\\Microsoft-AzCLI.zip' -DestinationPath '.\\package' -Force; & '.\\package\\Deploy-AzCLI.ps1' -DeploymentType 'Install'\"",
      "remove": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command \"Expand-Archive -LiteralPath '.\\Microsoft-AzCLI.zip' -DestinationPath '.\\package' -Force; & '.\\package\\Deploy-AzCLI.ps1' -DeploymentType 'Uninstall'\"",
      "targetRegions": [
        {
          "name": "eastus2",
          "regionalReplicaCount": 1,
          "storageAccountType": "Standard_LRS"
        }
      ],
      "excludeFromLatest": false,
      "scriptBehaviorAfterReboot": "Rerun"
    },
    {
      "name": "UserCertificateBackupRestore",
      "version": "1.0.0",
      "packageBlob": "UserCertificateBackupRestore.zip",
      "packageFileName": "UserCertificateBackupRestore.zip",
      "supportedOSType": "Windows",
      "description": "Interactive software certificate restore and backup tools for Entra-joined FSLogix session hosts.",
      "install": "powershell.exe -NoLogo -NoProfile -NonInteractive -Command \"$ErrorActionPreference = 'Stop'; Expand-Archive -LiteralPath '.\\UserCertificateBackupRestore.zip' -DestinationPath '.\\package' -Force; $LASTEXITCODE = 0; & '.\\package\\Deploy-UserCertificateBackupRestore.ps1' -DeploymentType 'Install'; exit $LASTEXITCODE\"",
      "remove": "powershell.exe -NoLogo -NoProfile -NonInteractive -Command \"$ErrorActionPreference = 'Stop'; Expand-Archive -LiteralPath '.\\UserCertificateBackupRestore.zip' -DestinationPath '.\\package' -Force; $LASTEXITCODE = 0; & '.\\package\\Deploy-UserCertificateBackupRestore.ps1' -DeploymentType 'Uninstall'; exit $LASTEXITCODE\"",
      "update": "powershell.exe -NoLogo -NoProfile -NonInteractive -Command \"$ErrorActionPreference = 'Stop'; Expand-Archive -LiteralPath '.\\UserCertificateBackupRestore.zip' -DestinationPath '.\\package' -Force; $LASTEXITCODE = 0; & '.\\package\\Deploy-UserCertificateBackupRestore.ps1' -DeploymentType 'Install'; exit $LASTEXITCODE\"",
      "targetRegions": [
        {
          "name": "eastus2",
          "regionalReplicaCount": 1,
          "storageAccountType": "Standard_LRS"
        }
      ],
      "excludeFromLatest": false,
      "scriptBehaviorAfterReboot": "None"
    }
  ]
}
