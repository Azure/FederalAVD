<?xml version="1.0" encoding="utf-8"?>
<policyDefinitionResources revision="1.0" schemaVersion="1.0">
  <displayName>User Certificate Backup &amp; Restore</displayName>
  <description>Computer-scoped folder policies for software certificate restore and backup.</description>
  <resources>
    <stringTable>
      <string id="CertificateSignInCategory">User Certificate Backup &amp; Restore</string>
      <string id="RestoreFolderName">Set the managed certificate restore folder</string>
      <string id="BackupFolderName">Set the managed certificate backup folder</string>
      <string id="ExpiryWarningDaysName">Set the certificate expiry warning period</string>
      <string id="ExpiryWarningDaysExplain">When enabled, writes ExpiryWarningDays under HKLM\Software\Policies\CertificateSignIn as a DWORD from 1 to 365. Both the restore form and backup helper use this warning window, overriding the helper's command-line warning period. This changes warnings only; it does not renew certificates, prevent expired certificate imports, or change certificate trust. Disabled removes this policy's warning period. Not Configured does not enforce a period through this GPO; other management may still set the registry value. When the registry value is absent, the restore form uses 30 days and the helper uses its command-line/default value of 30 days. Relaunch the application after policy refresh.</string>
      <string id="RestoreFolderExplain">When enabled, writes RestoreFolder under HKLM\Software\Policies\CertificateSignIn as an expandable string. The restore form reads the 64-bit registry view and expands environment variables, such as %USERPROFILE% or %USERNAME%, in the signed-in user's context. This value overrides command-line paths, saved preferences, and deployment defaults, and locks the restore folder controls. Use an absolute local or UNC path. The folder need not exist during policy configuration, but the user's PFX/P12 backup must be available before restore. Set the backup folder to the same location unless an approved process transfers the complete PFX and matching manifest. This policy does not change folder permissions, export private keys, repair FSLogix/DPAPI, or enable smart-card authentication. Disabled removes this policy's folder setting. Not Configured does not enforce a folder through this policy; deployment or other management may still set the registry value. When the registry value is absent, precedence is explicit command-line InputPath, shared HKCU\Software\CertificateSignIn\InputPath user preference, legacy JSON preference, then deployment default. Remember folder in either unmanaged form saves the shared HKCU preference as REG_EXPAND_SZ; this is not a user policy. Relaunch the application after policy refresh or preference changes.</string>
      <string id="BackupFolderExplain">When enabled, writes BackupFolder under HKLM\Software\Policies\CertificateSignIn as an expandable string. The backup form reads the 64-bit registry view and expands environment variables in the signed-in user's context. This value overrides command-line paths, saved preferences, and deployment defaults, and locks the backup folder controls. Use an absolute local or UNC path private to the user and within the authorized security boundary. Users need permission to write their own encrypted PFX and manifest. Set the restore folder to the same location unless you provide consistent transfer of both files. This policy does not provision storage, grant permissions, enroll certificates, export keys unattended, or store passwords. Disabled removes this policy's folder setting. Not Configured does not enforce a folder through this policy; deployment or other management may still set the registry value. When the registry value is absent, precedence is explicit command-line InputPath, shared HKCU\Software\CertificateSignIn\InputPath user preference, legacy JSON preference, then deployment default. Remember folder in either unmanaged form saves the shared HKCU preference as REG_EXPAND_SZ; this is not a user policy. Relaunch the application after policy refresh or preference changes.</string>
    </stringTable>
    <presentationTable>
      <presentation id="RestoreFolderPresentation">
        <textBox refId="RestoreFolderValue">
          <label>Managed restore folder:</label>
          <defaultValue>%USERPROFILE%\Documents\CertificateBackups</defaultValue>
        </textBox>
      </presentation>
      <presentation id="BackupFolderPresentation">
        <textBox refId="BackupFolderValue">
          <label>Managed backup folder:</label>
          <defaultValue>%USERPROFILE%\Documents\CertificateBackups</defaultValue>
        </textBox>
      </presentation>
      <presentation id="ExpiryWarningDaysPresentation">
        <decimalTextBox refId="ExpiryWarningDaysValue" defaultValue="30">Days before expiry to warn:</decimalTextBox>
      </presentation>
    </presentationTable>
  </resources>
</policyDefinitionResources>
