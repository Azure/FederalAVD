<?xml version="1.0" encoding="utf-8"?>
<policyDefinitions revision="1.0" schemaVersion="1.0">
  <policyNamespaces>
    <target prefix="certificateSignIn" namespace="CertificateSignIn.Policies" />
    <using prefix="windows" namespace="Microsoft.Policies.Windows" />
  </policyNamespaces>
  <resources minRequiredRevision="1.0" />
  <categories>
    <category name="CertificateSignIn" displayName="$(string.CertificateSignInCategory)" />
  </categories>
  <policies>
    <policy name="SetRestoreFolder" class="Machine"
            displayName="$(string.RestoreFolderName)" explainText="$(string.RestoreFolderExplain)"
            presentation="$(presentation.RestoreFolderPresentation)"
            key="Software\Policies\CertificateSignIn">
      <parentCategory ref="CertificateSignIn" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0" />
      <elements>
        <text id="RestoreFolderValue" valueName="RestoreFolder" required="true" expandable="true" maxLength="32767" />
      </elements>
    </policy>
    <policy name="SetBackupFolder" class="Machine"
            displayName="$(string.BackupFolderName)" explainText="$(string.BackupFolderExplain)"
            presentation="$(presentation.BackupFolderPresentation)"
            key="Software\Policies\CertificateSignIn">
      <parentCategory ref="CertificateSignIn" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0" />
      <elements>
        <text id="BackupFolderValue" valueName="BackupFolder" required="true" expandable="true" maxLength="32767" />
      </elements>
    </policy>
    <policy name="SetExpiryWarningDays" class="Machine"
            displayName="$(string.ExpiryWarningDaysName)" explainText="$(string.ExpiryWarningDaysExplain)"
            presentation="$(presentation.ExpiryWarningDaysPresentation)"
            key="Software\Policies\CertificateSignIn">
      <parentCategory ref="CertificateSignIn" />
      <supportedOn ref="windows:SUPPORTED_Windows_10_0" />
      <elements>
        <decimal id="ExpiryWarningDaysValue" valueName="ExpiryWarningDays" required="true" minValue="1" maxValue="365" />
      </elements>
    </policy>
  </policies>
</policyDefinitions>
